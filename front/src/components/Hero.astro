---
import SearchWidget from './SearchWidget.astro';
---

<section class="hero-section">
  <!-- Coastal Ambient Background Elements -->
  <div class="coastal-wave-accent" aria-hidden="true"></div>
  <div class="coastal-sun-glow" aria-hidden="true"></div>

  <div class="container hero-container">
    <!-- Top badge -->
    <div class="hero-badge-wrapper">
      <div class="badge badge-fresh hero-badge">
        <span class="pulse-dot"></span>
        <span class="badge-text">Movilidad Costera Inteligente en El Salvador</span>
      </div>
    </div>

    <!-- Main Heading and Lead -->
    <div class="hero-content">
      <h1 class="hero-title">
        Viaja <span class="text-ocean">fresco</span>, <span class="text-secure">seguro</span> y conectado por cada ruta
      </h1>
      <p class="hero-subtitle">
        Conecta conductores con asientos libres y pasajeros verificados hacia Surf City, Santa Tecla, San Salvador y más. Comparte combustible, viaja relajado y cuida tu bolsillo con brisa marina.
      </p>

      <!-- Trust Metrics Micro-strip -->
      <div class="hero-trust-strip">
        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <span>Perfiles 100% Verificados</span>
        </div>

        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <span>Puntos de Salida Puntuales</span>
        </div>

        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <span>Rastreo Geoespacial PostGIS</span>
        </div>
      </div>
    </div>

    <!-- Interactive Search Widget Placement -->
    <div class="hero-search-wrapper">
      <SearchWidget />
    </div>

    <!-- Live Coastal Stats Bar -->
    <div class="hero-stats-bar">
      <div class="stat-card">
        <span class="stat-number">1,850+</span>
        <span class="stat-label">Viajes completados</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-card">
        <span class="stat-number">4.9 ★</span>
        <span class="stat-label">Calificación promedio</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-card">
        <span class="stat-number">-65%</span>
        <span class="stat-label">Gasto en transporte</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-card">
        <span class="stat-number">14.2 T</span>
        <span class="stat-label">CO₂ reducido</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .coastal-wave-accent {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(143, 214, 200, 0.22) 0%, rgba(15, 138, 139, 0.05) 50%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  .coastal-sun-glow {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(242, 233, 216, 0.6) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    padding: 0.4rem 1rem;
    font-size: 0.86rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--color-seafoam);
    box-shadow: 0 4px 12px rgba(143, 214, 200, 0.25);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-ocean);
    border-radius: 50%;
    display: inline-block;
    position: relative;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(15, 138, 139, 0.4);
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto 2.5rem auto;
  }

  .hero-title {
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-slate);
  }

  .text-ocean {
    color: var(--color-ocean);
    position: relative;
    display: inline-block;
  }

  .text-ocean::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(143, 214, 200, 0.35);
    border-radius: 4px;
    z-index: -1;
  }

  .text-secure {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-slate-muted);
    line-height: 1.6;
    max-width: 760px;
    margin: 0 auto 2rem auto;
  }

  /* Trust Strip */
  .hero-trust-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.8rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-slate);
  }

  .trust-icon-wrap {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: rgba(143, 214, 200, 0.3);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Search Widget Placement */
  .hero-search-wrapper {
    width: 100%;
    max-width: 1080px;
    margin-bottom: 3rem;
  }

  /* Stats Bar */
  .hero-stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    padding: 1.2rem 2.5rem;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-full);
    border: 1px solid rgba(143, 214, 200, 0.3);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-slate-muted);
  }

  .stat-divider {
    width: 1px;
    height: 28px;
    background-color: rgba(11, 93, 103, 0.15);
  }

  @media (max-width: 768px) {
    .hero-stats-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }
    .stat-divider {
      display: none;
    }
  }
</style>
