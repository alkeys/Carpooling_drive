---
// BookingModal.astro - Modal interactivo de reserva y publicación de viajes
---

<!-- Modal de Reserva de Asiento -->
<div class="modal-backdrop" id="booking-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-booking-title">
  <div class="modal-container glass-card">
    <div class="modal-header">
      <div class="modal-header-text">
        <span class="badge badge-fresh">Reserva Segura</span>
        <h3 id="modal-booking-title">Confirmar Reserva de Cupo</h3>
      </div>
      <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Cerrar ventana">
        &times;
      </button>
    </div>

    <div class="modal-body">
      <!-- Ride summary box -->
      <div class="modal-ride-summary">
        <div class="summary-driver-row">
          <div class="summary-avatar" id="modal-driver-avatar">R</div>
          <div class="summary-driver-meta">
            <strong id="modal-driver-name">Rodrigo Morales</strong>
            <span id="modal-driver-vehicle">Mazda CX-30 2023 · Blanco</span>
          </div>
          <div class="summary-rating">
            ★ 4.9 <span class="verified-check">✓ Verificado</span>
          </div>
        </div>

        <div class="summary-route-timeline">
          <div class="route-item">
            <span class="route-time" id="modal-route-time">06:45 AM</span>
            <span class="route-dot origin-dot"></span>
            <span class="route-location" id="modal-route-origin">San Salvador</span>
          </div>
          <div class="route-line"></div>
          <div class="route-item">
            <span class="route-time">Destino</span>
            <span class="route-dot dest-dot"></span>
            <span class="route-location" id="modal-route-dest">La Libertad / El Tunco</span>
          </div>
        </div>
      </div>

      <!-- Booking details form -->
      <form class="modal-form" id="booking-confirm-form" onsubmit="return false;">
        <div class="form-row">
          <div class="form-group">
            <label for="book-seats-qty">Cantidad de asientos:</label>
            <select id="book-seats-qty" class="modal-select">
              <option value="1" selected>1 asiento</option>
              <option value="2">2 asientos</option>
              <option value="3">3 asientos</option>
            </select>
          </div>

          <div class="form-group">
            <label for="book-pickup-notes">Punto exacto o referencia:</label>
            <input type="text" id="book-pickup-notes" class="modal-input" placeholder="Ej. Frente a pasarela Multiplaza" />
          </div>
        </div>

        <div class="form-group">
          <label for="book-phone">Teléfono / WhatsApp de contacto:</label>
          <input type="tel" id="book-phone" class="modal-input" placeholder="+503 7000-0000" value="+503 7" required />
        </div>

        <!-- Total Price Breakdown -->
        <div class="modal-price-breakdown">
          <div class="price-line">
            <span>Aporte sugerido por asiento:</span>
            <span id="modal-single-price">$2.50</span>
          </div>
          <div class="price-line">
            <span>Cargo de servicio comunitario:</span>
            <span class="free-tag">$0.00 (Fase Lanzamiento)</span>
          </div>
          <div class="price-line total-line">
            <strong>Total a compartir:</strong>
            <strong class="total-amount" id="modal-total-price">$2.50</strong>
          </div>
        </div>

        <div class="modal-safety-notice">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#0F8A8B">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
          </svg>
          <span>El conductor recibirá tu solicitud y se te habilitará el chat del viaje una vez confirmada.</span>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="modal-cancel-btn">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-booking">
            Confirmar y Solicitar Cupo
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal de Publicar Viaje (Conductor) -->
<div class="modal-backdrop" id="publish-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-publish-title">
  <div class="modal-container glass-card">
    <div class="modal-header">
      <div class="modal-header-text">
        <span class="badge badge-sand">Publicar Ruta</span>
        <h3 id="modal-publish-title">Publica tu viaje y comparte gastos</h3>
        <div style="margin-top: 0.5rem; background: rgba(143, 214, 200, 0.2); border-radius: 8px; padding: 0.45rem 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font-size: 0.8rem;">
          <span>🗺️ ¿Quieres fijar puntos y paradas en el mapa?</span>
          <a href="/publicar" style="color: var(--color-ocean); font-weight: 700; text-decoration: none; white-space: nowrap;">Abrir con Mapa ➔</a>
        </div>
      </div>
      <button type="button" class="modal-close-btn" id="modal-publish-close-btn" aria-label="Cerrar ventana">
        &times;
      </button>
    </div>

    <div class="modal-body">
      <form class="modal-form" id="publish-trip-form" onsubmit="return false;">
        <div class="modal-alert" id="publish-alert" style="display: none;" role="alert">
          <span class="alert-icon">⚠️</span>
          <span id="publish-alert-text">Error al publicar viaje</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="pub-origin">Origen:</label>
            <input type="text" id="pub-origin" class="modal-input" placeholder="Ej. San Salvador (Multiplaza)" value="San Salvador (Multiplaza)" required />
          </div>
          <div class="form-group">
            <label for="pub-destination">Destino:</label>
            <input type="text" id="pub-destination" class="modal-input" placeholder="Ej. La Libertad (Playa El Tunco)" value="La Libertad (Playa El Tunco)" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="pub-date">Fecha de salida:</label>
            <input type="date" id="pub-date" class="modal-input" required />
          </div>
          <div class="form-group">
            <label for="pub-time">Hora de salida:</label>
            <input type="time" id="pub-time" class="modal-input" value="07:00" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="pub-seats">Asientos que ofreces:</label>
            <select id="pub-seats" class="modal-select">
              <option value="1">1 asiento</option>
              <option value="2">2 asientos</option>
              <option value="3" selected>3 asientos</option>
              <option value="4">4 asientos</option>
            </select>
          </div>
          <div class="form-group">
            <label for="pub-price">Aporte por asiento ($):</label>
            <input type="number" id="pub-price" class="modal-input" step="0.25" min="1.00" value="2.50" required />
          </div>
        </div>

        <div class="form-group" id="pub-vehicle-select-container">
          <label for="pub-vehicle-select">Vehículo a utilizar:</label>
          <select id="pub-vehicle-select" class="modal-select">
            <option value="new">+ Registrar nuevo vehículo</option>
          </select>
        </div>

        <div class="form-row" id="pub-vehicle-new-container" style="display: none;">
          <div class="form-group">
            <label for="pub-vehicle-brand">Marca y Modelo:</label>
            <input type="text" id="pub-vehicle-brand" class="modal-input" placeholder="Ej. Toyota Corolla" value="Toyota Corolla" />
          </div>
          <div class="form-group">
            <label for="pub-vehicle-plate">Número de Placa:</label>
            <input type="text" id="pub-vehicle-plate" class="modal-input" placeholder="Ej. P-123456" value="P-98214" />
          </div>
        </div>

        <div class="form-group">
          <label for="pub-desc">Notas o descripción del viaje (opcional):</label>
          <input type="text" id="pub-desc" class="modal-input" placeholder="Ej. Salida puntual. A/C encendido y espacio para maleta pequeña." value="Salida puntual. A/C encendido." />
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="modal-publish-cancel-btn">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-publish">
            <span class="pub-btn-text">Publicar Viaje en Rutea</span>
            <span class="pub-btn-spinner" style="display: none;">Publicando...</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Toast de Notificación Flotante -->
<div class="toast-notification" id="toast-notification" role="alert" aria-live="polite">
  <div class="toast-icon" id="toast-icon">✓</div>
  <div class="toast-content">
    <strong id="toast-title">¡Reserva solicitada!</strong>
    <span id="toast-message">El conductor ha sido notificado por WhatsApp y la app.</span>
  </div>
</div>

<style>
  /* Backdrop */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(28, 31, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .modal-backdrop.show {
    display: flex;
    opacity: 1;
  }

  /* Container */
  .modal-container {
    width: 100%;
    max-width: 540px;
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    padding: 2rem;
    position: relative;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3);
    max-height: 90vh;
    overflow-y: auto;
    animation: modalPopIn 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes modalPopIn {
    from { transform: scale(0.92) translateY(12px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .modal-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .modal-header-text h3 {
    font-size: 1.35rem;
    color: var(--color-slate);
  }

  .modal-close-btn {
    background: transparent;
    border: none;
    font-size: 1.8rem;
    color: var(--color-slate-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0 0.3rem;
  }

  .modal-close-btn:hover {
    color: var(--color-slate);
  }

  /* Ride Summary */
  .modal-ride-summary {
    background: var(--color-sand-light);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(11, 93, 103, 0.1);
  }

  .summary-driver-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(11, 93, 103, 0.12);
  }

  .summary-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .summary-driver-meta {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .summary-driver-meta strong {
    font-size: 0.95rem;
    color: var(--color-slate);
  }

  .summary-driver-meta span {
    font-size: 0.78rem;
    color: var(--color-slate-muted);
  }

  .summary-rating {
    font-size: 0.8rem;
    font-weight: 700;
    color: #D97706;
  }

  .verified-check {
    display: block;
    color: var(--color-ocean);
    font-size: 0.72rem;
  }

  .summary-route-timeline {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .route-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
  }

  .route-time {
    font-weight: 700;
    color: var(--color-primary);
    min-width: 65px;
  }

  .route-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .origin-dot {
    background: var(--color-ocean);
  }

  .dest-dot {
    background: var(--color-primary);
  }

  .route-line {
    width: 2px;
    height: 8px;
    background: var(--color-seafoam);
    margin-left: 74px;
  }

  .route-location {
    font-weight: 600;
    color: var(--color-slate);
  }

  /* Form */
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-slate-muted);
  }

  .modal-select,
  .modal-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid rgba(11, 93, 103, 0.15);
    background: #FFFFFF;
    font-size: 0.92rem;
    color: var(--color-slate);
    outline: none;
    transition: all var(--transition-fast);
  }

  .modal-select:focus,
  .modal-input:focus {
    border-color: var(--color-ocean);
    box-shadow: 0 0 0 3px rgba(143, 214, 200, 0.35);
  }

  /* Price breakdown */
  .modal-price-breakdown {
    background: var(--color-sand-light);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .price-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--color-slate-muted);
  }

  .free-tag {
    color: var(--color-ocean);
    font-weight: 600;
  }

  .total-line {
    padding-top: 0.5rem;
    margin-top: 0.3rem;
    border-top: 1px dashed rgba(11, 93, 103, 0.15);
    color: var(--color-slate);
  }

  .total-amount {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-primary);
  }

  .modal-safety-notice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-slate-muted);
    background: rgba(143, 214, 200, 0.18);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .modal-alert {
    background: #FEF2F2;
    border: 1px solid #F87171;
    color: #991B1B;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1.4;
  }

  .modal-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Toast Notification */
  .toast-notification {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 1100;
    background: #FFFFFF;
    border: 1px solid var(--color-seafoam);
    box-shadow: 0 12px 30px rgba(11, 93, 103, 0.2);
    border-radius: var(--radius-md);
    padding: 1rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transform: translateY(120px);
    opacity: 0;
    transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .toast-notification.active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .toast-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-ocean);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  .toast-content {
    display: flex;
    flex-direction: column;
  }

  .toast-content strong {
    font-size: 0.95rem;
    color: var(--color-slate);
  }

  .toast-content span {
    font-size: 0.82rem;
    color: var(--color-slate-muted);
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .modal-container {
      padding: 1.5rem;
    }
  }
</style>

<script>
  import { authService, solicitudesService, viajesService } from '../services';

  // Interactive modal logic
  const bookingModal = document.getElementById('booking-modal');
  const publishModal = document.getElementById('publish-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const publishCloseBtn = document.getElementById('modal-publish-close-btn');
  const publishCancelBtn = document.getElementById('modal-publish-cancel-btn');

  // Trigger elements
  const openDriverBtn = document.getElementById('btn-open-driver-modal');
  const publishHeaderBtn = document.getElementById('btn-publish-ride');
  const bookButtons = document.querySelectorAll('.book-ride-btn');

  // Fields in booking modal
  const modalDriverAvatar = document.getElementById('modal-driver-avatar');
  const modalDriverName = document.getElementById('modal-driver-name');
  const modalDriverVehicle = document.getElementById('modal-driver-vehicle');
  const modalRouteTime = document.getElementById('modal-route-time');
  const modalRouteOrigin = document.getElementById('modal-route-origin');
  const modalRouteDest = document.getElementById('modal-route-dest');
  const modalSinglePrice = document.getElementById('modal-single-price');
  const modalTotalPrice = document.getElementById('modal-total-price');
  const seatsQtySelect = document.getElementById('book-seats-qty') as HTMLSelectElement | null;
  const bookPhoneInput = document.getElementById('book-phone') as HTMLInputElement | null;

  // Toast
  const toast = document.getElementById('toast-notification');
  const toastTitle = document.getElementById('toast-title');
  const toastMessage = document.getElementById('toast-message');

  let activeRidePrice = 2.50;
  let activeRideId = '';

  function populateAndOpenBooking(
    rideId: string,
    driver: string,
    origin: string,
    dest: string,
    time: string,
    vehicle: string,
    price: number,
    maxSeats: number
  ) {
    // REQUISITO ESTRICTO: Obligatorio iniciar sesión o registrarse para reservar
    if (!authService.requireAuth('reservar tu asiento en este viaje')) {
      try {
        sessionStorage.setItem('pending_booking_ride', JSON.stringify({
          rideId, driver, origin, dest, time, vehicle, price, seats: maxSeats
        }));
      } catch {}
      return;
    }

    activeRideId = rideId;
    activeRidePrice = price;

    if (modalDriverAvatar) modalDriverAvatar.textContent = driver.slice(0, 1);
    if (modalDriverName) modalDriverName.textContent = driver;
    if (modalDriverVehicle) modalDriverVehicle.textContent = vehicle;
    if (modalRouteTime) modalRouteTime.textContent = time;
    if (modalRouteOrigin) modalRouteOrigin.textContent = origin;
    if (modalRouteDest) modalRouteDest.textContent = dest;
    if (modalSinglePrice) modalSinglePrice.textContent = `$${price.toFixed(2)}`;

    // Autocompletar datos del pasajero si está guardado en sesión
    const storedUser = authService.getStoredUser();
    if (storedUser?.telefono && bookPhoneInput) {
      bookPhoneInput.value = storedUser.telefono;
    }

    // Update seats options
    if (seatsQtySelect) {
      seatsQtySelect.innerHTML = '';
      for (let i = 1; i <= maxSeats; i++) {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = `${i} asiento${i > 1 ? 's' : ''}`;
        seatsQtySelect.appendChild(opt);
      }
      seatsQtySelect.value = '1';
    }

    updateBookingTotal();
    openModal(bookingModal);
  }

  // Reanudar reserva o publicación pendiente una vez el usuario inicia sesión o se registra
  window.addEventListener('auth-state-changed', ((e: CustomEvent) => {
    if (e.detail?.user) {
      // 1. Reanudar reserva pendiente
      const pendingJson = sessionStorage.getItem('pending_booking_ride');
      if (pendingJson) {
        try {
          const d = JSON.parse(pendingJson);
          sessionStorage.removeItem('pending_booking_ride');
          setTimeout(() => {
            populateAndOpenBooking(
              d.rideId,
              d.driver,
              d.origin,
              d.dest,
              d.time,
              d.vehicle,
              parseFloat(d.price || '2.50'),
              parseInt(d.seats || '3', 10)
            );
          }, 350);
        } catch {}
      }

      // 2. Reanudar publicación pendiente
      const pendingAction = sessionStorage.getItem('pending_action');
      if (pendingAction === 'publish_ride') {
        sessionStorage.removeItem('pending_action');
        setTimeout(() => {
          openPublishModal();
        }, 350);
      }
    }
  }) as EventListener);


  // Listen to open-booking-modal from dynamically rendered cards
  window.addEventListener('open-booking-modal', ((e: CustomEvent) => {
    const d = e.detail;
    if (!d) return;
    populateAndOpenBooking(
      d.rideId,
      d.driver,
      d.origin,
      d.dest,
      d.time,
      d.vehicle,
      parseFloat(d.price || '2.50'),
      parseInt(d.seats || '3', 10)
    );
  }) as EventListener);

  // Open booking modal for static SSR cards
  bookButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      populateAndOpenBooking(
        target.getAttribute('data-ride-id') || '',
        target.getAttribute('data-driver') || 'Conductor',
        target.getAttribute('data-origin') || 'San Salvador',
        target.getAttribute('data-dest') || 'La Libertad',
        target.getAttribute('data-time') || '07:00 AM',
        target.getAttribute('data-vehicle') || 'Vehículo verificado',
        parseFloat(target.getAttribute('data-price') || '2.50'),
        parseInt(target.getAttribute('data-seats') || '3', 10)
      );
    });
  });

  seatsQtySelect?.addEventListener('change', () => {
    updateBookingTotal();
  });

  function updateBookingTotal() {
    const qty = parseInt(seatsQtySelect?.value || '1', 10);
    const total = qty * activeRidePrice;
    if (modalTotalPrice) modalTotalPrice.textContent = `$${total.toFixed(2)}`;
  }

  // Carga de vehículos registrados del conductor
  let cachedVehicles: any[] = [];
  const vehicleSelect = document.getElementById('pub-vehicle-select') as HTMLSelectElement | null;
  const newVehicleContainer = document.getElementById('pub-vehicle-new-container') as HTMLElement | null;

  async function loadDriverVehicles() {
    if (!vehicleSelect) return;
    try {
      const { vehiculosService } = await import('../services');
      cachedVehicles = await vehiculosService.getMisVehiculos();
      vehicleSelect.innerHTML = '';

      if (cachedVehicles && cachedVehicles.length > 0) {
        cachedVehicles.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v.id;
          opt.textContent = `${v.marca} ${v.modelo} (${v.placa}) · Capacidad: ${v.capacidadPasajeros} pasajeros`;
          vehicleSelect.appendChild(opt);
        });

        const newOpt = document.createElement('option');
        newOpt.value = 'new';
        newOpt.textContent = '+ Registrar otro vehículo';
        vehicleSelect.appendChild(newOpt);

        if (newVehicleContainer) newVehicleContainer.style.display = 'none';
      } else {
        const newOpt = document.createElement('option');
        newOpt.value = 'new';
        newOpt.textContent = '+ Registrar nuevo vehículo';
        vehicleSelect.appendChild(newOpt);

        if (newVehicleContainer) newVehicleContainer.style.display = 'grid';
      }
    } catch {
      // Fallback sin vehículos
      if (vehicleSelect) {
        vehicleSelect.innerHTML = '<option value="new">+ Registrar nuevo vehículo</option>';
      }
      if (newVehicleContainer) newVehicleContainer.style.display = 'grid';
    }
  }

  vehicleSelect?.addEventListener('change', () => {
    if (newVehicleContainer) {
      newVehicleContainer.style.display = vehicleSelect.value === 'new' ? 'grid' : 'none';
    }
  });

  async function openPublishModal() {
    if (!authService.requireAuth('publicar un viaje')) {
      sessionStorage.setItem('pending_action', 'publish_ride');
      return;
    }

    const pubDate = document.getElementById('pub-date') as HTMLInputElement | null;
    const todayStr = new Date().toISOString().split('T')[0];
    if (pubDate) {
      pubDate.min = todayStr;
      if (!pubDate.value || pubDate.value < todayStr) {
        pubDate.value = todayStr;
      }
    }

    await loadDriverVehicles();
    openModal(publishModal);
  }

  // Open publish modal with strict authentication check
  [openDriverBtn, publishHeaderBtn].forEach(btn => {
    btn?.addEventListener('click', (e) => {
      e.preventDefault();
      openPublishModal();
    });
  });

  // Close handlers
  [modalCloseBtn, modalCancelBtn].forEach(btn => {
    btn?.addEventListener('click', () => closeModal(bookingModal));
  });

  [publishCloseBtn, publishCancelBtn].forEach(btn => {
    btn?.addEventListener('click', () => closeModal(publishModal));
  });

  // Close on outside click
  window.addEventListener('click', (e) => {
    if (e.target === bookingModal) closeModal(bookingModal);
    if (e.target === publishModal) closeModal(publishModal);
  });

  function openModal(modalEl: HTMLElement | null) {
    if (!modalEl) return;
    modalEl.style.display = 'flex';
    setTimeout(() => {
      modalEl.classList.add('show');
      modalEl.setAttribute('aria-hidden', 'false');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeModal(modalEl: HTMLElement | null) {
    if (!modalEl) return;
    modalEl.classList.remove('show');
    modalEl.setAttribute('aria-hidden', 'true');
    setTimeout(() => {
      modalEl.style.display = 'none';
      document.body.style.overflow = '';
    }, 200);
  }

  // Submit booking
  const bookingForm = document.getElementById('booking-confirm-form');
  bookingForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!authService.requireAuth('completar la reserva')) {
      closeModal(bookingModal);
      return;
    }

    closeModal(bookingModal);
    try {
      if (activeRideId && activeRideId.includes('-') && activeRideId.length === 36) {
        await solicitudesService.solicitarCupo({
          viajeId: activeRideId,
          cantidadCupos: parseInt(seatsQtySelect?.value || '1', 10),
          puntoSubidaNotas: (document.getElementById('book-pickup-notes') as HTMLInputElement)?.value.trim() || undefined
        });
      }
      showToast(
        '¡Reserva Solicitada con Éxito!',
        'El conductor fue notificado y tienes tu cupo reservado. Revisa tu chat y WhatsApp.'
      );
    } catch (err: any) {
      const msg = err?.data?.message || err?.message || 'No se pudo registrar la reserva en el servidor.';
      showToast(
        'Aviso de Solicitud',
        msg
      );
    }
  });

  function resolveCoordinates(name: string, isOrigin: boolean): { lat: number; lon: number } {
    const q = (name || '').toLowerCase().trim();
    if (q.includes('tunco') || q.includes('sunzal') || q.includes('zonte') || q.includes('taquillo')) {
      return { lat: 13.4938, lon: -89.3853 };
    }
    if (q.includes('libertad') || q.includes('puerto')) {
      return { lat: 13.4889, lon: -89.3197 };
    }
    if (q.includes('sol') || q.includes('costa del sol')) {
      return { lat: 13.3333, lon: -89.0167 };
    }
    if (q.includes('santa tecla') || q.includes('tecla') || q.includes('merliot')) {
      return { lat: 13.6769, lon: -89.2797 };
    }
    if (q.includes('santa ana') || q.includes('metapán') || q.includes('chalchuapa')) {
      return { lat: 13.9942, lon: -89.5597 };
    }
    if (q.includes('san miguel') || q.includes('usulután')) {
      return { lat: 13.4833, lon: -88.1833 };
    }
    if (q.includes('sonsonate') || q.includes('acajutla')) {
      return { lat: 13.7189, lon: -89.7242 };
    }
    if (q.includes('aeropuerto') || q.includes('comalapa') || q.includes('aop')) {
      return { lat: 13.4409, lon: -89.0557 };
    }
    if (q.includes('soyapango') || q.includes('ilopango')) {
      return { lat: 13.7102, lon: -89.1399 };
    }
    if (q.includes('antiguo') || q.includes('cuscatl') || q.includes('multiplaza')) {
      return { lat: 13.6739, lon: -89.2514 };
    }
    return isOrigin ? { lat: 13.6989, lon: -89.1914 } : { lat: 13.4889, lon: -89.3197 };
  }

  // Submit publish with authentication guard and API call
  const publishForm = document.getElementById('publish-trip-form');
  publishForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const publishAlert = document.getElementById('publish-alert');
    const publishAlertText = document.getElementById('publish-alert-text');
    function showPublishError(msg: string) {
      if (publishAlert && publishAlertText) {
        publishAlertText.textContent = msg;
        publishAlert.style.display = 'flex';
      }
      showToast('Error al publicar', msg);
    }
    function hidePublishError() {
      if (publishAlert) publishAlert.style.display = 'none';
    }

    hidePublishError();

    // Verificación de autenticación
    if (!authService.isAuthenticated()) {
      sessionStorage.setItem('pending_action', 'publish_ride');
      authService.requireAuth('publicar un viaje');
      closeModal(publishModal);
      return;
    }

    const origin = (document.getElementById('pub-origin') as HTMLInputElement)?.value.trim();
    const destination = (document.getElementById('pub-destination') as HTMLInputElement)?.value.trim();
    const date = (document.getElementById('pub-date') as HTMLInputElement)?.value;
    const time = (document.getElementById('pub-time') as HTMLInputElement)?.value;
    const seats = parseInt((document.getElementById('pub-seats') as HTMLSelectElement)?.value || '3', 10);
    const price = parseFloat((document.getElementById('pub-price') as HTMLInputElement)?.value || '2.50');
    const desc = (document.getElementById('pub-desc') as HTMLInputElement)?.value.trim() || 'Viaje compartido verificado en Rutea';

    if (!origin || !destination) {
      showPublishError('Debes ingresar punto de origen y destino.');
      return;
    }

    if (!date) {
      showPublishError('Debes seleccionar la fecha del viaje.');
      return;
    }

    const todayStr = new Date().toISOString().split('T')[0];
    if (date < todayStr) {
      showPublishError('La fecha de salida no puede ser anterior a hoy.');
      return;
    }

    if (!time) {
      showPublishError('Debes seleccionar la hora de salida.');
      return;
    }

    const submitBtn = document.getElementById('btn-submit-publish') as HTMLButtonElement | null;
    const btnText = submitBtn?.querySelector('.pub-btn-text') as HTMLElement | null;
    const btnSpinner = submitBtn?.querySelector('.pub-btn-spinner') as HTMLElement | null;

    if (submitBtn) submitBtn.disabled = true;
    if (btnText && btnSpinner) {
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline';
    }

    try {
      const { vehiculosService } = await import('../services');
      let vehiculoId: string | null = null;
      const vehicleSelectVal = vehicleSelect?.value;

      if (vehicleSelectVal && vehicleSelectVal !== 'new') {
        const found = cachedVehicles.find(v => v.id === vehicleSelectVal);
        if (found) {
          if (found.capacidadPasajeros < seats) {
            showPublishError(`El vehículo seleccionado (${found.marca} ${found.modelo}) tiene capacidad para ${found.capacidadPasajeros} pasajeros, pero estás ofreciendo ${seats} cupos. Reduce los asientos o registra un vehículo con más capacidad.`);
            if (submitBtn) submitBtn.disabled = false;
            if (btnText && btnSpinner) {
              btnText.style.display = 'inline';
              btnSpinner.style.display = 'none';
            }
            return;
          }
          vehiculoId = found.id;
        }
      }

      // Si se necesita registrar un vehículo nuevo o el usuario no tiene vehículo con suficiente capacidad
      if (!vehiculoId) {
        const brandInput = (document.getElementById('pub-vehicle-brand') as HTMLInputElement)?.value.trim() || 'Toyota Corolla';
        const plateInput = (document.getElementById('pub-vehicle-plate') as HTMLInputElement)?.value.trim() || `P-${Math.floor(100000 + Math.random() * 899999)}`;
        
        const parts = brandInput.split(' ');
        const marca = parts[0] || 'Toyota';
        const modelo = parts.slice(1).join(' ') || 'Corolla';

        const nuevoVehiculo = await vehiculosService.registrarVehiculo({
          marca: marca.slice(0, 50),
          modelo: modelo.slice(0, 50),
          color: 'Blanco',
          anio: 2023,
          tipo: 'SEDAN',
          placa: plateInput.toUpperCase().slice(0, 20),
          capacidadPasajeros: Math.max(seats, 4)
        });
        vehiculoId = nuevoVehiculo.id;
      }

      const origenCoords = resolveCoordinates(origin, true);
      const destinoCoords = resolveCoordinates(destination, false);

      await viajesService.publicarViaje({
        vehiculoId,
        origenNombre: origin,
        origenLat: origenCoords.lat,
        origenLon: origenCoords.lon,
        destinoNombre: destination,
        destinoLat: destinoCoords.lat,
        destinoLon: destinoCoords.lon,
        fechaSalida: date,
        horaSalida: time,
        cuposTotales: seats,
        cuposDisponibles: seats,
        tarifaAproximada: price,
        descripcion: desc
      });

      closeModal(publishModal);

      showToast(
        '¡Viaje Publicado con Éxito!',
        `Tu ruta ${origin} ➔ ${destination} ya está disponible en vivo para los pasajeros.`
      );

      // Recargar lista de viajes en vivo
      window.dispatchEvent(new CustomEvent('ride-published'));
    } catch (err: any) {
      console.error('Error publicando viaje:', err);
      let errorMsg = 'No se pudo publicar el viaje.';
      if (err?.data?.message) {
        errorMsg = err.data.message;
      } else if (err?.data?.validationErrors) {
        errorMsg = Object.values(err.data.validationErrors).join(', ');
      } else if (err?.message) {
        errorMsg = err.message;
      }
      showPublishError(errorMsg);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText && btnSpinner) {
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
      }
    }
  });

  function showToast(title: string, msg: string) {
    if (!toast) return;
    if (toastTitle) toastTitle.textContent = title;
    if (toastMessage) toastMessage.textContent = msg;

    toast.classList.add('active');
    setTimeout(() => {
      toast.classList.remove('active');
    }, 4500);
  }
</script>
