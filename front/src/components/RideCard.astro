---
// RideCard.astro - Tarjeta de viaje costero minimalista ultra premium
export interface RideProps {
  id: string;
  driverName: string;
  driverRole?: string;
  driverRating: number;
  driverTrips: number;
  origin: string;
  destination: string;
  departureTime: string;
  arrivalTime: string;
  duration: string;
  vehicle: string;
  availableSeats: number;
  totalSeats: number;
  price: number;
  tags: string[];
  category: 'costa' | 'urbano' | 'interurbano';
  description?: string;
}

const {
  id,
  driverName = "Conductor Verificado",
  driverRating = 4.9,
  driverTrips = 64,
  origin,
  destination,
  departureTime,
  arrivalTime = "Llegada directa",
  duration,
  vehicle = "Vehículo Verificado",
  availableSeats,
  totalSeats,
  price,
  tags = [],
  category = "urbano",
  description
} = Astro.props as RideProps;

const categoryBadgeClass = category === 'costa' ? 'badge-fresh' : 'badge-secure';
const categoryBadgeText = category === 'costa' ? '🌊 Ruta Costera' : category === 'interurbano' ? '🛣️ Interurbano' : '⚡ Ruta Diaria';
---

<article 
  class="ride-card glass-card" 
  data-ride-id={id}
  data-origin={origin}
  data-destination={destination}
  data-category={category}
  data-seats={availableSeats}
  data-price={price}
>
  <!-- Card Header: Driver profile & Verified badge -->
  <div class="card-header">
    <div class="driver-info">
      <div class="driver-avatar-circle" aria-hidden="true">
        <span>{driverName.slice(0, 1)}</span>
      </div>
      <div class="driver-meta">
        <div class="driver-name-row">
          <span class="driver-name">{driverName}</span>
          <span class="verified-pill" title="Identidad y vehículo 100% verificados">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="#0F8A8B">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span>Verificado</span>
          </span>
        </div>
        <div class="driver-subline">
          <span class="rating-badge">★ {driverRating.toFixed(1)}</span>
          <span class="dot-sep">·</span>
          <span class="trips-count">{driverTrips} viajes</span>
        </div>
      </div>
    </div>

    <!-- Category Pill -->
    <span class={`badge ${categoryBadgeClass}`}>
      {categoryBadgeText}
    </span>
  </div>

  <!-- Route Timeline visual -->
  <div class="route-timeline">
    <div class="timeline-step origin-step">
      <div class="time-col">{departureTime}</div>
      <div class="marker-col">
        <span class="node-ring origin-ring"></span>
        <span class="track-line"></span>
      </div>
      <div class="location-col">
        <strong class="location-name">{origin}</strong>
        <span class="location-sub">Punto de encuentro seguro</span>
      </div>
    </div>

    <div class="timeline-duration-row">
      <span class="duration-badge">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{duration} directo</span>
      </span>
    </div>

    <div class="timeline-step dest-step">
      <div class="time-col">{arrivalTime}</div>
      <div class="marker-col">
        <span class="node-ring dest-ring"></span>
      </div>
      <div class="location-col">
        <strong class="location-name">{destination}</strong>
        <span class="location-sub">Destino principal</span>
      </div>
    </div>
  </div>

  <!-- Driver note if available -->
  {description && (
    <div class="ride-card-note">
      <span class="note-quote-mark" aria-hidden="true">“</span>
      <p class="note-text">{description}</p>
    </div>
  )}

  <!-- Vehicle & Amenities tags -->
  <div class="card-vehicle-row">
    <div class="vehicle-info">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      </svg>
      <span>{vehicle}</span>
    </div>

    <div class="amenities-tags">
      {tags.map((tag) => (
        <span class="amenity-tag">{tag}</span>
      ))}
    </div>
  </div>

  <!-- Card Footer: Seats, Price & Action -->
  <div class="card-footer">
    <div class="seats-counter">
      <div class="seats-icons" aria-label={`${availableSeats} asientos de ${totalSeats} libres`}>
        {Array.from({ length: totalSeats }).map((_, i) => (
          <span class={`seat-dot ${i < availableSeats ? 'seat-free' : 'seat-taken'}`} title={i < availableSeats ? 'Disponible' : 'Ocupado'}></span>
        ))}
      </div>
      <span class="seats-label">
        <strong>{availableSeats}</strong> {availableSeats === 1 ? 'asiento libre' : 'asientos libres'}
      </span>
    </div>

    <div class="price-action-box">
      <div class="price-box">
        <span class="price-amount">${price.toFixed(2)}</span>
        <span class="price-unit">/ persona</span>
      </div>

      <div class="card-buttons-group">
        <button 
          type="button" 
          class="btn btn-outline btn-sm chat-ride-btn" 
          data-ride-id={id}
          data-driver={driverName}
          data-origin={origin}
          data-dest={destination}
          title="Consultar al conductor o soporte"
        >
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>Chat</span>
        </button>

        <button 
          type="button" 
          class="btn btn-primary btn-sm book-ride-btn" 
          data-ride-id={id}
          data-driver={driverName}
          data-origin={origin}
          data-dest={destination}
          data-time={departureTime}
          data-price={price.toFixed(2)}
          data-vehicle={vehicle}
          data-seats={availableSeats}
        >
          <span>Reservar</span>
        </button>
      </div>
    </div>
  </div>
</article>
