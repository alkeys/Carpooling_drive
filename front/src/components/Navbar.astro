---
// Navbar.astro - Barra de navegación costera minimalista
---

<header class="navbar-wrapper">
  <div class="container navbar-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Rutea - Inicio">
      <div class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="10" fill="#0B5D67" />
          <path d="M4 25C11 19 17 29 23 23C27 19 32 22 32 22" stroke="#8FD6C8" stroke-width="2.5" stroke-linecap="round" opacity="0.5" />
          <path d="M7 21C12 13 21 12 29 16" stroke="#F2E9D8" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="21" cy="15" r="3.5" fill="#8FD6C8" />
          <circle cx="21" cy="15" r="1.5" fill="#0B5D67" />
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">Rutea</span>
        <span class="brand-tag">Costero & Seguro</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Navegación principal">
      <a href="/#buscar" class="nav-link">Buscar Viaje</a>
      <a href="/#rutas" class="nav-link">Rutas Costeras</a>
      <a href="/mis-viajes" class="nav-link user-nav-link" id="nav-link-my-trips" style="display: none;">🚗 Mis Viajes</a>
      <a href="/viajes-seleccionados" class="nav-link user-nav-link" id="nav-link-my-bookings" style="display: none;">🎟️ Viajes Seleccionados</a>
      <a href="/mensajes" class="nav-link user-nav-link" id="nav-link-messages" style="display: none;">💬 Mensajes</a>
      <a href="/admin" class="nav-link admin-nav-pill" id="nav-link-admin" style="display: none; color: #D97706; font-weight: 700; background: rgba(217, 119, 6, 0.1); padding: 0.25rem 0.65rem; border-radius: 9999px;">
        ⚡ Admin
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <!-- Botón de Ingreso (Visible si no hay sesión) -->
      <button type="button" class="btn btn-ghost btn-sm" id="btn-login" aria-label="Iniciar Sesión">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>Ingresar</span>
      </button>

      <!-- Grupo de Usuario Autenticado (Desktop) -->
      <div class="nav-user-group" id="nav-user-group" style="display: none;">
        <div class="nav-user-chip" id="nav-user-chip" title="Usuario conectado">
          <span class="user-avatar-circle" id="nav-user-avatar">U</span>
          <span class="user-display-name" id="nav-user-name">Usuario</span>
        </div>
        <button type="button" class="btn btn-logout-nav btn-sm" id="btn-logout" title="Cerrar sesión y borrar cookies" aria-label="Cerrar Sesión">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar Sesión</span>
        </button>
      </div>

      <a href="/publicar" class="btn btn-primary btn-sm" id="btn-publish-ride">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <span>Publicar Viaje</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="mobile-toggle" id="mobile-menu-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav-links">
      <a href="/#buscar" class="mobile-nav-link">Buscar Viaje</a>
      <a href="/#rutas" class="mobile-nav-link">Rutas Costeras</a>
      <a href="/mis-viajes" class="mobile-nav-link mobile-user-nav-link" id="mobile-nav-link-my-trips" style="display: none;">🚗 Mis Viajes (Conductor)</a>
      <a href="/viajes-seleccionados" class="mobile-nav-link mobile-user-nav-link" id="mobile-nav-link-my-bookings" style="display: none;">🎟️ Viajes Seleccionados (Reservas)</a>
      <a href="/mensajes" class="mobile-nav-link mobile-user-nav-link" id="mobile-nav-link-messages" style="display: none;">💬 Mensajes & Chat</a>
      <a href="/admin" class="mobile-nav-link" id="mobile-nav-link-admin" style="display: none; color: #D97706; font-weight: 700;">⚡ Panel de Administración</a>
      
      <!-- Mobile Auth State -->
      <div class="mobile-actions">
        <!-- Logged out action -->
        <button type="button" class="btn btn-outline" id="mobile-btn-login" style="width: 100%;">Ingresar / Registrarse</button>

        <!-- Logged in details & logout -->
        <div class="mobile-user-profile" id="mobile-user-profile" style="display: none;">
          <div class="mobile-user-meta">
            <span class="user-avatar-circle" id="mobile-avatar">U</span>
            <div class="mobile-user-texts">
              <span class="mobile-user-name" id="mobile-username">Usuario</span>
              <span class="mobile-user-role" id="mobile-userrole">Sesión activa</span>
            </div>
          </div>
          <button type="button" class="btn btn-mobile-logout" id="mobile-btn-logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>

        <a href="/publicar" class="btn btn-primary" id="mobile-btn-publish" style="width: 100%; text-align: center;">Publicar Viaje</a>
      </div>
    </nav>
  </div>

  <!-- Notification Toast -->
  <div class="nav-toast" id="nav-toast" role="status" aria-live="polite">
    <div class="nav-toast-icon">🌊</div>
    <div class="nav-toast-body">
      <strong class="nav-toast-title" id="nav-toast-title">Notificación</strong>
      <p class="nav-toast-desc" id="nav-toast-desc">Detalle del mensaje</p>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(143, 214, 200, 0.35);
    transition: all var(--transition-normal);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-normal);
  }

  .brand-logo:hover .logo-icon {
    transform: scale(1.06) rotate(-2deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    line-height: 1;
  }

  .brand-tag {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ocean);
  }

  /* Desktop Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-slate-muted);
    position: relative;
    padding: 0.4rem 0;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--color-ocean);
    border-radius: 99px;
    transition: width var(--transition-normal);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-sm);
  }

  .mobile-toggle span {
    display: block;
    width: 100%;
    height: 2.2px;
    background-color: var(--color-slate);
    border-radius: 99px;
    transition: all var(--transition-normal);
  }

  .mobile-toggle.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Dropdown */
  .mobile-menu {
    display: none;
    background: #FFFFFF;
    border-top: 1px solid rgba(143, 214, 200, 0.3);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-slate);
  }

  .mobile-actions {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-sand);
  }

  /* User & Logout Styles */
  .nav-user-group {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-user-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(143, 214, 200, 0.18);
    border: 1px solid rgba(143, 214, 200, 0.45);
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .user-avatar-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #0F8A8B;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .user-display-name {
    max-width: 120px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-logout-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.25);
    color: #DC2626;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-logout-nav:hover {
    background: #DC2626;
    border-color: #DC2626;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
  }

  /* Mobile User Profile & Logout */
  .mobile-user-profile {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.85rem;
    background: rgba(15, 138, 139, 0.06);
    border-radius: var(--radius-md);
    border: 1px solid rgba(143, 214, 200, 0.35);
  }

  .mobile-user-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-user-texts {
    display: flex;
    flex-direction: column;
  }

  .mobile-user-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-slate);
  }

  .mobile-user-role {
    font-size: 0.76rem;
    color: var(--color-ocean);
    font-weight: 600;
  }

  .btn-mobile-logout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.3);
    color: #DC2626;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-mobile-logout:hover {
    background: #DC2626;
    color: #FFFFFF;
  }

  /* Global Coastal Toast */
  .nav-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #FFFFFF;
    border: 1px solid rgba(143, 214, 200, 0.5);
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(11, 93, 103, 0.15), 0 8px 10px -6px rgba(11, 93, 103, 0.1);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1000;
    transform: translateY(100px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    max-width: 380px;
  }

  .nav-toast.show {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-toast-icon {
    font-size: 1.3rem;
  }

  .nav-toast-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-toast-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .nav-toast-desc {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-slate-muted);
  }

  @media (max-width: 992px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    #btn-login,
    .nav-user-group {
      display: none !important;
    }
  }
</style>

<script>
  import { authService } from '../services';

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const btnLogin = document.getElementById('btn-login');
  const navUserGroup = document.getElementById('nav-user-group');
  const navUserName = document.getElementById('nav-user-name');
  const navUserAvatar = document.getElementById('nav-user-avatar');
  const btnLogout = document.getElementById('btn-logout');

  const mobileBtnLogin = document.getElementById('mobile-btn-login');
  const mobileUserProfile = document.getElementById('mobile-user-profile');
  const mobileUsername = document.getElementById('mobile-username');
  const mobileUserRole = document.getElementById('mobile-userrole');
  const mobileAvatar = document.getElementById('mobile-avatar');
  const mobileBtnLogout = document.getElementById('mobile-btn-logout');
  const mobileBtnPublish = document.getElementById('mobile-btn-publish');

  // Toggle mobile menu
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.classList.toggle('active');
      mobileMenu.classList.toggle('open');
    });

    // Close when clicking mobile links
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.classList.remove('active');
        mobileMenu.classList.remove('open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Mobile publish link close menu
  mobileBtnPublish?.addEventListener('click', () => {
    mobileMenu?.classList.remove('open');
    toggleBtn?.classList.remove('active');
  });

  // Mobile login click
  mobileBtnLogin?.addEventListener('click', () => {
    mobileMenu?.classList.remove('open');
    toggleBtn?.classList.remove('active');
    window.dispatchEvent(new CustomEvent('request-auth-required', {
      detail: { action: 'ingresar a tu cuenta' }
    }));
  });

  // Logout click handlers (Desktop & Mobile)
  btnLogout?.addEventListener('click', handleLogout);
  mobileBtnLogout?.addEventListener('click', handleLogout);

  async function handleLogout() {
    try {
      if (btnLogout) {
        btnLogout.innerHTML = `<span>Cerrando...</span>`;
        btnLogout.setAttribute('disabled', 'true');
      }
      if (mobileBtnLogout) {
        mobileBtnLogout.textContent = 'Cerrando sesión...';
        mobileBtnLogout.setAttribute('disabled', 'true');
      }

      // Invoca el endpoint POST /api/v1/auth/logout y limpia el almacenamiento
      const res = await authService.logout();

      showNavToast(
        'Sesión finalizada', 
        res?.mensaje || 'Se ha cerrado la sesión y las cookies fueron eliminadas correctamente.',
        '🔒'
      );
    } catch (err: any) {
      console.warn('Advertencia durante logout:', err);
      showNavToast('Sesión cerrada', 'Tus cookies y datos de sesión han sido borrados.', 'ℹ️');
    } finally {
      if (btnLogout) {
        btnLogout.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar Sesión</span>
        `;
        btnLogout.removeAttribute('disabled');
      }
      if (mobileBtnLogout) {
        mobileBtnLogout.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar Sesión</span>
        `;
        mobileBtnLogout.removeAttribute('disabled');
      }

      mobileMenu?.classList.remove('open');
      toggleBtn?.classList.remove('active');
      resetNavUser();
    }
  }

  function showNavToast(title: string, desc: string, icon = '🌊') {
    const toast = document.getElementById('nav-toast');
    const toastTitle = document.getElementById('nav-toast-title');
    const toastDesc = document.getElementById('nav-toast-desc');
    const iconEl = toast?.querySelector('.nav-toast-icon');
    if (!toast || !toastTitle || !toastDesc) return;

    toastTitle.textContent = title;
    toastDesc.textContent = desc;
    if (iconEl) iconEl.textContent = icon;

    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 4500);
  }

  // Escucha de evento global para mostrar toast si otro componente lo requiere
  window.addEventListener('app-toast', ((e: CustomEvent) => {
    if (e.detail?.title && e.detail?.desc) {
      showNavToast(e.detail.title, e.detail.desc, e.detail.icon || '🌊');
    }
  }) as EventListener);

  const navLinkAdmin = document.getElementById('nav-link-admin');
  const mobileNavLinkAdmin = document.getElementById('mobile-nav-link-admin');

  const navLinkMyTrips = document.getElementById('nav-link-my-trips');
  const navLinkMyBookings = document.getElementById('nav-link-my-bookings');
  const navLinkMessages = document.getElementById('nav-link-messages');

  const mobileNavLinkMyTrips = document.getElementById('mobile-nav-link-my-trips');
  const mobileNavLinkMyBookings = document.getElementById('mobile-nav-link-my-bookings');
  const mobileNavLinkMessages = document.getElementById('mobile-nav-link-messages');

  // Check stored user on load
  const storedUser = authService.getStoredUser();
  if (storedUser) {
    updateNavUser(storedUser);
  } else {
    resetNavUser();
  }

  window.addEventListener('auth-state-changed', ((e: CustomEvent) => {
    const user = e.detail?.user;
    if (user) {
      updateNavUser(user);
    } else {
      resetNavUser();
    }
  }) as EventListener);

  function updateNavUser(user: any) {
    const name = typeof user === 'string' ? user : (user?.nombre || 'Usuario');
    const roleList = user?.roles || [];
    const roleText = roleList.includes('ADMIN') ? 'Administrador' : (roleList.includes('CONDUCTOR') ? 'Conductor' : 'Pasajero');
    const isAdmin = Boolean(roleList.includes('ADMIN') || authService.getStoredUser()?.roles?.includes('ADMIN' as any));
    const firstInitial = (name[0] || 'U').toUpperCase();
    const shortName = name.split(' ')[0];

    // Ocultar botón Ingresar y mostrar grupo de usuario autenticado
    if (btnLogin) btnLogin.style.display = 'none';
    if (navUserGroup) navUserGroup.style.display = 'inline-flex';
    if (navUserName) navUserName.textContent = shortName;
    if (navUserAvatar) navUserAvatar.textContent = firstInitial;

    // Enlaces de navegación de usuario autenticado
    if (navLinkMyTrips) navLinkMyTrips.style.display = 'inline-flex';
    if (navLinkMyBookings) navLinkMyBookings.style.display = 'inline-flex';
    if (navLinkMessages) navLinkMessages.style.display = 'inline-flex';

    if (mobileNavLinkMyTrips) mobileNavLinkMyTrips.style.display = 'block';
    if (mobileNavLinkMyBookings) mobileNavLinkMyBookings.style.display = 'block';
    if (mobileNavLinkMessages) mobileNavLinkMessages.style.display = 'block';

    // Menú móvil perfil
    if (mobileBtnLogin) mobileBtnLogin.style.display = 'none';
    if (mobileUserProfile) mobileUserProfile.style.display = 'flex';
    if (mobileUsername) mobileUsername.textContent = name;
    if (mobileUserRole) mobileUserRole.textContent = `Rol: ${roleText}`;
    if (mobileAvatar) mobileAvatar.textContent = firstInitial;

    // Enlaces de administración
    if (navLinkAdmin) navLinkAdmin.style.display = isAdmin ? 'inline-flex' : 'none';
    if (mobileNavLinkAdmin) mobileNavLinkAdmin.style.display = isAdmin ? 'block' : 'none';
  }

  function resetNavUser() {
    // Restaurar botón de login en desktop y ocultar grupo autenticado
    if (btnLogin) {
      btnLogin.style.display = 'inline-flex';
    }
    if (navUserGroup) {
      navUserGroup.style.display = 'none';
    }

    // Ocultar enlaces de usuario
    if (navLinkMyTrips) navLinkMyTrips.style.display = 'none';
    if (navLinkMyBookings) navLinkMyBookings.style.display = 'none';
    if (navLinkMessages) navLinkMessages.style.display = 'none';

    if (mobileNavLinkMyTrips) mobileNavLinkMyTrips.style.display = 'none';
    if (mobileNavLinkMyBookings) mobileNavLinkMyBookings.style.display = 'none';
    if (mobileNavLinkMessages) mobileNavLinkMessages.style.display = 'none';

    // Restaurar menú móvil
    if (mobileBtnLogin) {
      mobileBtnLogin.style.display = 'block';
    }
    if (mobileUserProfile) {
      mobileUserProfile.style.display = 'none';
    }

    // Ocultar enlaces de administración
    if (navLinkAdmin) navLinkAdmin.style.display = 'none';
    if (mobileNavLinkAdmin) mobileNavLinkAdmin.style.display = 'none';
  }
</script>
