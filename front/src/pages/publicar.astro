    dateInput.value = todayStr;

    document.querySelectorAll('#date-quick-pills .pill-shortcut').forEach(pill => {
      pill.addEventListener('click', (e) => {
        document.querySelectorAll('#date-quick-pills .pill-shortcut').forEach(p => p.classList.remove('active'));
        (e.currentTarget as HTMLElement).classList.add('active');

        const days = (e.currentTarget as HTMLElement).getAttribute('data-days');
        const d = new Date();
        if (days === 'weekend') {
          // Próximo sábado
          const dayOfWeek = d.getDay();
          const daysToSat = (6 - dayOfWeek + 7) % 7 || 7;
          d.setDate(d.getDate() + daysToSat);
        } else {
          d.setDate(d.getDate() + parseInt(days || '0', 10));
        }
        dateInput.value = d.toISOString().split('T')[0];
        updateLivePreview();
      });
    });

    document.querySelectorAll('#time-quick-pills .pill-shortcut').forEach(pill => {
      pill.addEventListener('click', (e) => {
        document.querySelectorAll('#time-quick-pills .pill-shortcut').forEach(p => p.classList.remove('active'));
        (e.currentTarget as HTMLElement).classList.add('active');
        const t = (e.currentTarget as HTMLElement).getAttribute('data-time');
        if (t && timeInput) {
          timeInput.value = t;
          updateLivePreview();
        }
      });
    });
  }

  // 2. Inicialización del Mapa Interactivo Leaflet
  function initLeafletMap() {
    if (!mapEl || typeof (window as any).L === 'undefined') {
      setTimeout(initLeafletMap, 150);
      return;
    }

    const L = (window as any).L;

    // Crear mapa centrado en El Salvador (San Salvador / La Libertad)
    map = L.map('route-map', {
      center: [13.62, -89.30],
      zoom: 11,
      zoomControl: true,
      scrollWheelZoom: true
    });

    // Capa de mosaico moderna de OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // Iconos personalizados con diseño costero
    const originIcon = L.divIcon({
      className: 'custom-map-marker marker-origin',
      html: `
        <div style="background:#10B981;width:34px;height:34px;border-radius:50%;border:3px solid #FFFFFF;box-shadow:0 4px 15px rgba(16,185,129,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;">
          📍
        </div>
      `,
      iconSize: [34, 34],
      iconAnchor: [17, 34]
    });

    const destIcon = L.divIcon({
      className: 'custom-map-marker marker-dest',
      html: `
        <div style="background:#0B5D67;width:34px;height:34px;border-radius:50%;border:3px solid #FFFFFF;box-shadow:0 4px 15px rgba(11,93,103,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;">
          🏁
        </div>
      `,
      iconSize: [34, 34],
      iconAnchor: [17, 34]
    });

    // Marcador Origen draggable
    originMarker = L.marker([originCoords.lat, originCoords.lon], {
      icon: originIcon,
      draggable: true,
      title: 'Punto de Salida'
    }).addTo(map);

    originMarker.bindPopup('<strong>📍 Punto de Origen</strong><br>' + originCoords.name);

    originMarker.on('dragend', (e: any) => {
      const pos = e.target.getLatLng();
      originCoords.lat = Number(pos.lat.toFixed(4));
      originCoords.lon = Number(pos.lng.toFixed(4));
      updateCoordsDisplay();
      redrawRoutePolyline();
    });

    // Marcador Destino draggable
    destMarker = L.marker([destCoords.lat, destCoords.lon], {
      icon: destIcon,
      draggable: true,
      title: 'Punto de Destino'
    }).addTo(map);

    destMarker.bindPopup('<strong>🏁 Punto de Destino</strong><br>' + destCoords.name);

    destMarker.on('dragend', (e: any) => {
      const pos = e.target.getLatLng();
      destCoords.lat = Number(pos.lat.toFixed(4));
      destCoords.lon = Number(pos.lng.toFixed(4));
      updateCoordsDisplay();
      redrawRoutePolyline();
    });

    // Clic en el mapa según la herramienta activa
    map.on('click', (e: any) => {
      const lat = Number(e.latlng.lat.toFixed(4));
      const lon = Number(e.latlng.lng.toFixed(4));

      if (currentMapMode === 'origin') {
        originCoords.lat = lat;
        originCoords.lon = lon;
        originMarker.setLatLng([lat, lon]);
        originCoords.name = resolveLocationNameFromCoords(lat, lon, 'Origen personalizado');
        if (originInput) originInput.value = originCoords.name;
        originMarker.setPopupContent('<strong>📍 Punto de Origen</strong><br>' + originCoords.name).openPopup();
      } else if (currentMapMode === 'dest') {
        destCoords.lat = lat;
        destCoords.lon = lon;
        destMarker.setLatLng([lat, lon]);
        destCoords.name = resolveLocationNameFromCoords(lat, lon, 'Destino personalizado');
        if (destInput) destInput.value = destCoords.name;
        destMarker.setPopupContent('<strong>🏁 Punto de Destino</strong><br>' + destCoords.name).openPopup();
      } else if (currentMapMode === 'stop') {
        addIntermediateStop(lat, lon, `Parada en km (${lat}, ${lon})`);
      }

      updateCoordsDisplay();
      redrawRoutePolyline();
      updateLivePreview();
    });

    redrawRoutePolyline();
  }

  // Trazar línea de ruta en el mapa
  function redrawRoutePolyline() {
    if (!map) return;
    const L = (window as any).L;

    if (routeLine) {
      map.removeLayer(routeLine);
    }

    const latlngs = [
      [originCoords.lat, originCoords.lon],
      ...intermediateStops.map(s => [s.lat, s.lon]),
      [destCoords.lat, destCoords.lon]
    ];

    routeLine = L.polyline(latlngs, {
      color: '#0F8A8B',
      weight: 5,
      opacity: 0.85,
      dashArray: '8, 8',
      lineCap: 'round'
    }).addTo(map);

    // Ajustar límites si es necesario
    try {
      map.fitBounds(routeLine.getBounds(), { padding: [50, 50] });
    } catch {}

    // Calcular distancia estimada
    const dist = calculateTotalDistance();
    if (metricDistance) metricDistance.textContent = `${dist} km`;
    if (metricDuration) {
      const mins = Math.max(20, Math.round(dist * 1.3));
      metricDuration.textContent = `${mins} min directo`;
    }
  }

  function calculateDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function calculateTotalDistance(): number {
    let total = 0;
    const pts = [
      originCoords,
      ...intermediateStops,
      destCoords
    ];
    for (let i = 0; i < pts.length - 1; i++) {
      total += calculateDistanceKm(pts[i].lat, pts[i].lon, pts[i + 1].lat, pts[i + 1].lon);
    }
    return Math.round(total * 1.3); // Corrección por trazado vial salvadoreño
  }

  function updateCoordsDisplay() {
    if (originCoordBadge) {
      originCoordBadge.textContent = `📍 Lat: ${originCoords.lat}, Lon: ${originCoords.lon}`;
    }
    if (destCoordBadge) {
      destCoordBadge.textContent = `🏁 Lat: ${destCoords.lat}, Lon: ${destCoords.lon}`;
    }
  }

  // Resolver nombre de lugar aproximado
  function resolveLocationNameFromCoords(lat: number, lon: number, fallback: string): string {
    if (lat >= 13.48 && lat <= 13.51 && lon >= -89.41 && lon <= -89.36) return 'Playa El Tunco / El Sunzal';
    if (lat >= 13.48 && lat <= 13.51 && lon >= -89.47 && lon <= -89.42) return 'Playa El Zonte, Chiltiupán';
    if (lat >= 13.47 && lat <= 13.50 && lon >= -89.33 && lon <= -89.30) return 'Puerto de La Libertad (Malecón)';
    if (lat >= 13.31 && lat <= 13.36 && lon >= -89.05 && lon <= -88.98) return 'Costa del Sol (Playa San Marcelino)';
    if (lat >= 13.66 && lat <= 13.69 && lon >= -89.30 && lon <= -89.26) return 'Santa Tecla (Paseo El Carmen)';
    if (lat >= 13.66 && lat <= 13.69 && lon >= -89.26 && lon <= -89.24) return 'Antiguo Cuscatlán / Multiplaza';
    if (lat >= 13.68 && lat <= 13.72 && lon >= -89.23 && lon <= -89.18) return 'San Salvador Centro (Metrocentro)';
    if (lat >= 13.43 && lat <= 13.46 && lon >= -89.08 && lon <= -89.04) return 'Aeropuerto Internacional Monseñor Romero (AOP)';
    if (lat >= 13.97 && lat <= 14.02 && lon >= -89.58 && lon <= -89.53) return 'Santa Ana Centro / Metrocentro';
    return fallback;
  }

  // 3. Modos de Mapa (Origen, Destino, Paradas)
  btnModeOrigin?.addEventListener('click', () => setMapMode('origin'));
  btnModeDest?.addEventListener('click', () => setMapMode('dest'));
  btnModeStop?.addEventListener('click', () => setMapMode('stop'));

  function setMapMode(mode: 'origin' | 'dest' | 'stop') {
    currentMapMode = mode;
    [btnModeOrigin, btnModeDest, btnModeStop].forEach(btn => btn?.classList.remove('active'));
    if (mode === 'origin') btnModeOrigin?.classList.add('active');
    if (mode === 'dest') btnModeDest?.classList.add('active');
    if (mode === 'stop') btnModeStop?.classList.add('active');
  }

  // 4. Paradas Intermedias (Puntos de Encuentro)
  const stopsListContainer = document.getElementById('stops-list-container');
  const btnAddStopRow = document.getElementById('btn-add-stop-row');

  btnAddStopRow?.addEventListener('click', () => {
    // Parada interpolada intermedia
    const midLat = Number(((originCoords.lat + destCoords.lat) / 2).toFixed(4));
    const midLon = Number(((originCoords.lon + destCoords.lon) / 2).toFixed(4));
    addIntermediateStop(midLat, midLon, 'Punto de encuentro intermedio');
  });

  function addIntermediateStop(lat: number, lon: number, name: string) {
    if (intermediateStops.length >= 3) {
      alert('Máximo 3 paradas intermedias para garantizar fluidez en el viaje.');
      return;
    }

    const L = (window as any).L;
    const stopIdx = intermediateStops.length + 1;
    const stopObj = { name, lat, lon };
    intermediateStops.push(stopObj);

    // Marcador en mapa
    const stopIcon = L.divIcon({
      className: 'custom-map-marker marker-stop',
      html: `
        <div style="background:#F59E0B;width:28px;height:28px;border-radius:50%;border:2px solid #FFFFFF;box-shadow:0 4px 10px rgba(245,158,11,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:800;">
          ${stopIdx}
        </div>
      `,
      iconSize: [28, 28],
      iconAnchor: [14, 28]
    });

    const marker = L.marker([lat, lon], {
      icon: stopIcon,
      draggable: true,
      title: `Parada ${stopIdx}`
    }).addTo(map);

    marker.bindPopup(`<strong>🟡 Parada ${stopIdx}</strong><br>${name}`);

    marker.on('dragend', (e: any) => {
      const pos = e.target.getLatLng();
      stopObj.lat = Number(pos.lat.toFixed(4));
      stopObj.lon = Number(pos.lng.toFixed(4));
      redrawRoutePolyline();
    });

    intermediateStopMarkers.push(marker);

    renderStopsList();
    redrawRoutePolyline();
  }

  function renderStopsList() {
    if (!stopsListContainer) return;
    stopsListContainer.innerHTML = '';

    intermediateStops.forEach((stop, idx) => {
      const row = document.createElement('div');
      row.className = 'stop-row-item';
      row.innerHTML = `
        <span class="stop-badge">${idx + 1}</span>
        <input type="text" class="stop-input" value="${stop.name}" placeholder="Nombre de la parada (ej. Gasolinera Texaco)" />
        <span style="font-size:11px;color:#64748B;">(${stop.lat}, ${stop.lon})</span>
        <button type="button" class="btn-remove-stop" title="Eliminar parada">&times;</button>
      `;

      const input = row.querySelector('.stop-input') as HTMLInputElement;
      input.addEventListener('input', () => {
        stop.name = input.value;
      });

      const removeBtn = row.querySelector('.btn-remove-stop') as HTMLButtonElement;
      removeBtn.addEventListener('click', () => {
        removeIntermediateStop(idx);
      });

      stopsListContainer.appendChild(row);
    });
  }

  function removeIntermediateStop(index: number) {
    if (intermediateStopMarkers[index] && map) {
      map.removeLayer(intermediateStopMarkers[index]);
    }
    intermediateStops.splice(index, 1);
    intermediateStopMarkers.splice(index, 1);
    renderStopsList();
    redrawRoutePolyline();
  }

  // 5. Atajos de Rutas Frecuentes
  document.querySelectorAll('.preset-pill').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.preset-pill').forEach(b => b.classList.remove('active'));
      (e.currentTarget as HTMLElement).classList.add('active');

      const preset = (e.currentTarget as HTMLElement).getAttribute('data-preset');
      applyRoutePreset(preset);
    });
  });

  function applyRoutePreset(preset: string | null) {
    if (preset === 'tunco') {
      originCoords = { lat: 13.6739, lon: -89.2514, name: 'San Salvador (Multiplaza)' };
      destCoords = { lat: 13.4938, lon: -89.3853, name: 'Playa El Tunco, La Libertad' };
    } else if (preset === 'zonte') {
      originCoords = { lat: 13.6769, lon: -89.2797, name: 'Santa Tecla (Paseo El Carmen)' };
      destCoords = { lat: 13.4983, lon: -89.4447, name: 'Playa El Zonte, Chiltiupán' };
    } else if (preset === 'sol') {
      originCoords = { lat: 13.6989, lon: -89.1914, name: 'San Salvador (Metrocentro)' };
      destCoords = { lat: 13.3333, lon: -89.0167, name: 'Costa del Sol (Playa San Marcelino)' };
    } else if (preset === 'santaana') {
      originCoords = { lat: 13.9942, lon: -89.5597, name: 'Santa Ana (Metrocentro)' };
      destCoords = { lat: 13.6989, lon: -89.1914, name: 'San Salvador Centro' };
    } else if (preset === 'aeropuerto') {
      originCoords = { lat: 13.6739, lon: -89.2514, name: 'San Salvador (Multiplaza)' };
      destCoords = { lat: 13.4409, lon: -89.0557, name: 'Aeropuerto Internacional Monseñor Romero (AOP)' };
    }

    if (originInput) originInput.value = originCoords.name;
    if (destInput) destInput.value = destCoords.name;

    if (originMarker) originMarker.setLatLng([originCoords.lat, originCoords.lon]).setPopupContent('<strong>📍 Punto de Origen</strong><br>' + originCoords.name);
    if (destMarker) destMarker.setLatLng([destCoords.lat, destCoords.lon]).setPopupContent('<strong>🏁 Punto de Destino</strong><br>' + destCoords.name);

    // Limpiar paradas intermedias de presets anteriores
    intermediateStopMarkers.forEach(m => map && map.removeLayer(m));
    intermediateStops = [];
    intermediateStopMarkers = [];
    renderStopsList();

    updateCoordsDisplay();
    redrawRoutePolyline();
    updateLivePreview();
  }

  // 6. Carga de Vehículos del Conductor
  const driverVehiclesContainer = document.getElementById('driver-vehicles-container');
  const newVehicleBox = document.getElementById('new-vehicle-box');

  async function loadDriverVehicles() {
    if (!driverVehiclesContainer) return;
    try {
      driverVehicles = await vehiculosService.getMisVehiculos();
      renderDriverVehicles();
    } catch {
      renderDriverVehicles();
    }
  }

  function renderDriverVehicles() {
    if (!driverVehiclesContainer) return;
    driverVehiclesContainer.innerHTML = '';

    if (driverVehicles && driverVehicles.length > 0) {
      driverVehicles.forEach((veh, idx) => {
        const isDefault = idx === 0;
        if (isDefault) selectedVehicleId = veh.id;

        const card = document.createElement('div');
        card.className = `vehicle-radio-card ${isDefault ? 'selected' : ''}`;
        card.setAttribute('data-veh-id', veh.id);
        card.innerHTML = `
          <div class="veh-radio-icon">🚘</div>
          <div class="veh-radio-details">
            <strong>${veh.marca} ${veh.modelo} (${veh.anio || 2023})</strong>
            <span>Placas: <code>${veh.placa}</code> · Color: ${veh.color || 'Blanco'}</span>
          </div>
          <div class="veh-radio-capacity">
            ${veh.capacidadPasajeros} pasajeros
          </div>
        `;

        card.addEventListener('click', () => {
          document.querySelectorAll('.vehicle-radio-card').forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');
          selectedVehicleId = veh.id;
          if (newVehicleBox) newVehicleBox.style.display = 'none';
          updateLivePreview();
        });

        driverVehiclesContainer.appendChild(card);
      });

      // Opción de registrar otro auto
      const newCard = document.createElement('div');
      newCard.className = 'vehicle-radio-card';
      newCard.setAttribute('data-veh-id', 'new');
      newCard.innerHTML = `
        <div class="veh-radio-icon">➕</div>
        <div class="veh-radio-details">
          <strong>Registrar otro auto</strong>
          <span>Añadir un vehículo nuevo con placas salvadoreñas</span>
        </div>
      `;
      newCard.addEventListener('click', () => {
        document.querySelectorAll('.vehicle-radio-card').forEach(c => c.classList.remove('selected'));
        newCard.classList.add('selected');
        selectedVehicleId = 'new';
        if (newVehicleBox) newVehicleBox.style.display = 'block';
        updateLivePreview();
      });

      driverVehiclesContainer.appendChild(newCard);
    } else {
      // No hay vehículos aún: mostrar formulario de nuevo auto
      selectedVehicleId = 'new';
      if (newVehicleBox) newVehicleBox.style.display = 'block';
      driverVehiclesContainer.innerHTML = `
        <div style="font-size:0.85rem;color:#0F8A8B;font-weight:700;margin-bottom:0.5rem;">
          ✨ Registraremos tu primer vehículo junto con la publicación de este viaje:
        </div>
      `;
    }
    updateLivePreview();
  }

  // 7. Calculadora de Aporte y Amortización
  seatsSelect?.addEventListener('change', updateLivePreview);
  priceInput?.addEventListener('input', updateLivePreview);
  originInput?.addEventListener('input', () => {
    originCoords.name = originInput.value;
    updateLivePreview();
  });
  destInput?.addEventListener('input', () => {
    destCoords.name = destInput.value;
    updateLivePreview();
  });
  descInput?.addEventListener('input', updateLivePreview);
  document.querySelectorAll('input[name="amenity"]').forEach(cb => {
    cb.addEventListener('change', updateLivePreview);
  });

  function updateLivePreview() {
    const originText = originInput?.value.trim() || 'San Salvador';
    const destText = destInput?.value.trim() || 'La Libertad';
    const timeVal = timeInput?.value || '07:00';
    const seats = parseInt(seatsSelect?.value || '3', 10);
    const price = parseFloat(priceInput?.value || '2.50');
    const descText = descInput?.value.trim() || '';

    // Actualizar vista previa
    if (prevOrigin) prevOrigin.textContent = originText;
    if (prevDest) prevDest.textContent = destText;

    // Formatear hora (12h)
    let formattedTime = timeVal;
    if (timeVal.length >= 5) {
      const parts = timeVal.split(':');
      const h = parseInt(parts[0], 10);
      const m = parts[1];
      const ampm = h >= 12 ? 'PM' : 'AM';
      const h12 = h % 12 || 12;
      formattedTime = `${String(h12).padStart(2, '0')}:${m} ${ampm}`;
    }
    if (prevDepTime) prevDepTime.textContent = formattedTime;

    // Categoría
    const combined = `${originText} ${destText}`.toLowerCase();
    const isCoast = /tunco|libertad|sol|playa|zonte|sunzal|costa|mar/i.test(combined);
    if (prevCategoryBadge) {
      prevCategoryBadge.textContent = isCoast ? '🌊 Ruta Costera' : '⚡ Ruta Diaria';
      prevCategoryBadge.className = isCoast ? 'badge badge-fresh' : 'badge badge-secure';
    }

    // Vehículo
    if (prevVehicleText) {
      if (selectedVehicleId && selectedVehicleId !== 'new') {
        const v = driverVehicles.find(x => x.id === selectedVehicleId);
        if (v) prevVehicleText.textContent = `${v.marca} ${v.modelo} · ${v.placa}`;
      } else {
        const brand = (document.getElementById('new-veh-brand') as HTMLInputElement)?.value || 'Toyota';
        const model = (document.getElementById('new-veh-model') as HTMLInputElement)?.value || 'Corolla';
        const plate = (document.getElementById('new-veh-plate') as HTMLInputElement)?.value || 'P-78219';
        prevVehicleText.textContent = `${brand} ${model} · ${plate}`;
      }
    }

    // Puntos de asientos
    if (prevSeatsDots) {
      prevSeatsDots.innerHTML = Array.from({ length: seats })
        .map(() => '<span class="seat-dot seat-free"></span>')
        .join('');
    }
    if (prevSeatsNum) prevSeatsNum.textContent = String(seats);

    // Precio
    if (prevPriceDisplay) prevPriceDisplay.textContent = `$${price.toFixed(2)}`;

    // Calculadora
    const totalCalc = (seats * price).toFixed(2);
    if (calcTotalDisplay) calcTotalDisplay.textContent = `$${totalCalc}`;
    if (calcFormulaDisplay) calcFormulaDisplay.textContent = `(${seats} asientos × $${price.toFixed(2)})`;

    // Notas
    if (prevNotesText && prevNotesBox) {
      if (descText) {
        prevNotesText.textContent = descText;
        prevNotesBox.style.display = 'flex';
      } else {
        prevNotesBox.style.display = 'none';
      }
    }

    // Amenidades tags
    if (prevAmenitiesTags) {
      const checkedBoxes = Array.from(document.querySelectorAll('input[name="amenity"]:checked')) as HTMLInputElement[];
      prevAmenitiesTags.innerHTML = checkedBoxes
        .slice(0, 3)
        .map(cb => `<span class="amenity-tag">${cb.value}</span>`)
        .join(' ');
    }

    // Driver user info
    const stored = authService.getStoredUser();
    if (stored) {
      if (prevDriverName) prevDriverName.textContent = `${stored.nombre} (Conductor Verificado)`;
      if (prevAvatar) prevAvatar.textContent = stored.nombre.charAt(0).toUpperCase();
    }
  }

  // 8. Envío y Publicación a la API
  const publishForm = document.getElementById('dedicated-publish-form');
  const submitBtn = document.getElementById('btn-submit-dedicated-publish') as HTMLButtonElement | null;

  function showAlert(title: string, msg: string) {
    if (globalAlert && alertTitle && alertText) {
      alertTitle.textContent = title;
      alertText.textContent = msg;
      globalAlert.style.display = 'flex';
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }
  }

  function hideAlert() {
    if (globalAlert) globalAlert.style.display = 'none';
  }

  publishForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    // Requisito estricto de autenticación
    if (!authService.isAuthenticated()) {
      sessionStorage.setItem('pending_action', 'publish_ride');
      authService.requireAuth('publicar un viaje como conductor');
      return;
    }

    const origin = originInput?.value.trim();
    const destination = destInput?.value.trim();
    const date = dateInput?.value;
    const time = timeInput?.value;
    const seats = parseInt(seatsSelect?.value || '3', 10);
    const price = parseFloat(priceInput?.value || '2.50');
    const desc = descInput?.value.trim() || 'Ruta compartida verificada en Rutea';

    if (!origin || !destination) {
      showAlert('Ruta Incompleta', 'Por favor ingresa tanto el punto de origen como de destino.');
      return;
    }

    if (!date) {
      showAlert('Fecha Requerida', 'Por favor selecciona la fecha de salida del viaje.');
      return;
    }

    const todayStr = new Date().toISOString().split('T')[0];
    if (date < todayStr) {
      showAlert('Fecha Inválida', 'La fecha de salida no puede ser anterior al día de hoy.');
      return;
    }

    if (!time) {
      showAlert('Hora Requerida', 'Por favor selecciona la hora de salida.');
      return;
    }

    // Estado del botón
    const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
    const btnSpinner = submitBtn?.querySelector('.btn-spinner') as HTMLElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (btnText && btnSpinner) {
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline';
    }

    try {
      let finalVehiculoId = selectedVehicleId;

      // Si seleccionó un vehículo existente, validar capacidad
      if (finalVehiculoId && finalVehiculoId !== 'new') {
        const found = driverVehicles.find(v => v.id === finalVehiculoId);
        if (found && found.capacidadPasajeros < seats) {
          showAlert(
            'Capacidad Insuficiente',
            `Tu auto seleccionado (${found.marca} ${found.modelo}) tiene capacidad para ${found.capacidadPasajeros} pasajeros, pero estás ofreciendo ${seats} asientos. Reduce los asientos o registra un auto con más cupos.`
          );
          restoreButton();
          return;
        }
      }

      // Si necesita registrar un vehículo nuevo
      if (!finalVehiculoId || finalVehiculoId === 'new') {
        const brand = (document.getElementById('new-veh-brand') as HTMLInputElement)?.value.trim() || 'Toyota';
        const model = (document.getElementById('new-veh-model') as HTMLInputElement)?.value.trim() || 'Corolla';
        const year = parseInt((document.getElementById('new-veh-year') as HTMLInputElement)?.value || '2023', 10);
        const color = (document.getElementById('new-veh-color') as HTMLInputElement)?.value.trim() || 'Blanco';
        const capacity = parseInt((document.getElementById('new-veh-capacity') as HTMLSelectElement)?.value || '4', 10);
        const plateInput = (document.getElementById('new-veh-plate') as HTMLInputElement)?.value.trim() || `P-${Math.floor(100000 + Math.random() * 899999)}`;

        const nuevoVehiculo = await vehiculosService.registrarVehiculo({
          marca: brand.slice(0, 50),
          modelo: model.slice(0, 50),
          anio: year,
          color: color.slice(0, 30),
          tipo: 'SEDAN',
          placa: plateInput.toUpperCase().slice(0, 20),
          capacidadPasajeros: Math.max(capacity, seats, 4)
        });

        finalVehiculoId = nuevoVehiculo.id;
      }

      // Paradas intermedias formateadas para el backend
      const puntosEncuentroDto: PuntoEncuentroRequest[] = intermediateStops.map((st, idx) => ({
        nombre: st.name.slice(0, 150),
        descripcion: st.desc || 'Parada en ruta',
        latitud: st.lat,
        longitud: st.lon,
        orden: idx + 1,
        permiteSubida: true,
        permiteBajada: true
      }));

      // Publicar viaje en Spring Boot PostGIS
      const viajeCreado = await viajesService.publicarViaje({
        vehiculoId: finalVehiculoId,
        origenNombre: origin,
        origenLat: originCoords.lat,
        origenLon: originCoords.lon,
        destinoNombre: destination,
        destinoLat: destCoords.lat,
        destinoLon: destCoords.lon,
        fechaSalida: date,
        horaSalida: time,
        cuposTotales: seats,
        cuposDisponibles: seats,
        tarifaAproximada: price,
        descripcion: desc,
        puntosEncuentro: puntosEncuentroDto.length > 0 ? puntosEncuentroDto : undefined
      });

      // Notificar éxito y redirigir al feed
      alert('¡Viaje publicado exitosamente en la plataforma Rutea!');
      window.location.href = '/#buscar';

    } catch (err: any) {
      console.error('Error al publicar viaje:', err);
      let msg = 'No se pudo registrar el viaje en el servidor.';
      if (err?.data?.message) {
        msg = err.data.message;
      } else if (err?.data?.validationErrors) {
        msg = Object.values(err.data.validationErrors).join(', ');
      } else if (err?.message) {
        msg = err.message;
      }
      showAlert('Error al Publicar Viaje', msg);
    } finally {
      restoreButton();
    }
  });

  function restoreButton() {
    if (submitBtn) submitBtn.disabled = false;
    const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
    const btnSpinner = submitBtn?.querySelector('.btn-spinner') as HTMLElement | null;
    if (btnText && btnSpinner) {
      btnText.style.display = 'inline';
      btnSpinner.style.display = 'none';
    }
  }

  // Listener para cuando el usuario se loguea en AuthModal
  window.addEventListener('auth-state-changed', ((e: CustomEvent) => {
    if (e.detail?.user) {
      loadDriverVehicles();
      updateLivePreview();
    }
  }) as EventListener);

  // Inicializar al cargar
  initDateShortcuts();
  initLeafletMap();
  loadDriverVehicles();
  updateLivePreview();
</script>
