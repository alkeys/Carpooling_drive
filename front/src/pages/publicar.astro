---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AuthModal from '../components/AuthModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Publicar Viaje | Rutea El Salvador - Conduce, Comparte y Ahorra"
  description="Publica tu ruta en El Salvador con mapa interactivo. Selecciona origen, destino y paradas hacia El Tunco, Surf City o San Salvador, define tus cupos y comparte gastos con pasajeros verificados."
>
  <!-- Leaflet CSS -->
  <link 
    rel="stylesheet" 
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
    crossorigin="" 
  />

  <Navbar />

  <main class="publish-page-main">
    <div class="container">
      <!-- Breadcrumbs & Heading -->
      <nav class="publish-breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">Publicar un Viaje</span>
      </nav>

      <div class="publish-hero-header">
        <div class="publish-header-badge">
          <span class="badge badge-fresh">🚗 Modo Conductor</span>
          <span class="publish-header-pill">100% de aportes para ti</span>
        </div>
        <h1 class="publish-main-title">Publica tu viaje y comparte gastos de gasolina</h1>
        <p class="publish-main-sub">
          Traza tu ruta de forma visual en el mapa interactivo, selecciona tus puntos de encuentro seguros y viaja acompañado por El Salvador con pasajeros verificados.
        </p>
      </div>

      <!-- Main Publishing Layout (2 Columns) -->
      <div class="publish-grid-layout">
        <!-- LEFT COLUMN: The Interactive Builder Form & Map -->
        <div class="publish-builder-column">

          <!-- Alert Banner -->
          <div class="publish-alert" id="publish-global-alert" style="display: none;" role="alert">
            <span class="alert-icon">⚠️</span>
            <div class="alert-body">
              <strong id="publish-alert-title">Atención</strong>
              <p id="publish-alert-text">Por favor revisa los campos señalados.</p>
            </div>
          </div>

          <form id="dedicated-publish-form" class="publish-form-card" onsubmit="return false;">
            
            <!-- STEP 1: Interactive Route & Map -->
            <section class="builder-section">
              <div class="section-badge-header">
                <span class="step-number">1</span>
                <div>
                  <h2 class="section-title">Traza tu Ruta en el Mapa</h2>
                  <p class="section-desc">Haz clic en el mapa para fijar tu punto de salida, llegada o paradas intermedias.</p>
                </div>
              </div>

              <!-- Route Quick Presets -->
              <div class="route-presets-wrapper">
                <span class="presets-label">Rutas frecuentes:</span>
                <div class="presets-pills">
                  <button type="button" class="preset-pill active" data-preset="tunco">
                    🏄 S.S. Multiplaza ➔ El Tunco
                  </button>
                  <button type="button" class="preset-pill" data-preset="zonte">
                    🌊 Santa Tecla ➔ El Zonte
                  </button>
                  <button type="button" class="preset-pill" data-preset="sol">
                    🌴 S.S. ➔ Costa del Sol
                  </button>
                  <button type="button" class="preset-pill" data-preset="santaana">
                    🏛️ Santa Ana ➔ San Salvador
                  </button>
                  <button type="button" class="preset-pill" data-preset="aeropuerto">
                    ✈️ San Salvador ➔ Aeropuerto AOP
                  </button>
                </div>
              </div>

              <!-- Map Interaction Toolbar -->
              <div class="map-toolbar">
                <span class="toolbar-label">Herramienta activa:</span>
                <div class="map-mode-buttons">
                  <button type="button" class="btn-mode active" id="btn-mode-origin" title="Haz clic en el mapa para mover el punto de origen">
                    <span class="mode-dot dot-origin"></span>
                    <span>1. Fijar Origen</span>
                  </button>
                  <button type="button" class="btn-mode" id="btn-mode-dest" title="Haz clic en el mapa para mover el punto de destino">
                    <span class="mode-dot dot-dest"></span>
                    <span>2. Fijar Destino</span>
                  </button>
                  <button type="button" class="btn-mode" id="btn-mode-stop" title="Haz clic en el mapa para añadir una parada intermedia">
                    <span class="mode-dot dot-stop"></span>
                    <span>+ Añadir Parada</span>
                  </button>
                </div>
              </div>

              <!-- Interactive Leaflet Map Container -->
              <div class="map-container-frame">
                <div id="route-map" class="route-map" style="height: 420px; width: 100%;"></div>
                
                <!-- Overlay badge with live metrics -->
                <div class="map-metrics-overlay" id="map-metrics-overlay">
                  <div class="metric-item">
                    <span class="metric-icon">🛣️</span>
                    <div>
                      <span class="metric-label">Distancia estimada</span>
                      <strong class="metric-val" id="metric-distance">38 km</strong>
                    </div>
                  </div>
                  <div class="metric-sep"></div>
                  <div class="metric-item">
                    <span class="metric-icon">⏱️</span>
                    <div>
                      <span class="metric-label">Tiempo aprox.</span>
                      <strong class="metric-val" id="metric-duration">45 min directo</strong>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Location Inputs Grid -->
              <div class="location-fields-grid">
                <!-- Origin -->
                <div class="field-card origin-card">
                  <div class="field-card-header">
                    <span class="field-dot dot-origin"></span>
                    <label for="pub-origin-input">Punto de Salida / Origen:</label>
                  </div>
                  <input 
                    type="text" 
                    id="pub-origin-input" 
                    class="pub-input" 
                    placeholder="Ej. San Salvador (Centro Comercial Multiplaza)" 
                    value="San Salvador (Multiplaza)" 
                    required 
                  />
                  <div class="coord-badge" id="origin-coord-badge">
                    <span>📍 Lat: 13.6739, Lon: -89.2514</span>
                  </div>
                </div>

                <!-- Destination -->
                <div class="field-card dest-card">
                  <div class="field-card-header">
                    <span class="field-dot dot-dest"></span>
                    <label for="pub-dest-input">Punto de Llegada / Destino:</label>
                  </div>
                  <input 
                    type="text" 
                    id="pub-dest-input" 
                    class="pub-input" 
                    placeholder="Ej. Playa El Tunco, La Libertad" 
                    value="Playa El Tunco, La Libertad" 
                    required 
                  />
                  <div class="coord-badge" id="dest-coord-badge">
                    <span>🏁 Lat: 13.4938, Lon: -89.3853</span>
                  </div>
                </div>
              </div>

              <!-- Intermediate Stops Container -->
              <div class="intermediate-stops-wrap" id="intermediate-stops-wrap">
                <div class="stops-header">
                  <label>Paradas intermedias opcionales (Puntos de recogida):</label>
                  <button type="button" class="btn-text-action" id="btn-add-stop-row">
                    + Añadir parada manual
                  </button>
                </div>
                <div id="stops-list-container" class="stops-list">
                  <!-- Dynamic stops rows injected here -->
                </div>
              </div>
            </section>

            <!-- STEP 2: Date & Time Schedule -->
            <section class="builder-section">
              <div class="section-badge-header">
                <span class="step-number">2</span>
                <div>
                  <h2 class="section-title">Fecha y Horario de Salida</h2>
                  <p class="section-desc">Programa con puntualidad para que los pasajeros organicen su llegada.</p>
                </div>
              </div>

              <div class="form-row-2">
                <!-- Date picker & Quick days -->
                <div class="form-group">
                  <label for="pub-date-input">Fecha del viaje:</label>
                  <input type="date" id="pub-date-input" class="pub-input" required />
                  <div class="quick-pills-row" id="date-quick-pills">
                    <button type="button" class="pill-shortcut active" data-days="0">Hoy</button>
                    <button type="button" class="pill-shortcut" data-days="1">Mañana</button>
                    <button type="button" class="pill-shortcut" data-days="2">Pasado Mañana</button>
                    <button type="button" class="pill-shortcut" data-days="weekend">Fin de semana</button>
                  </div>
                </div>

                <!-- Time picker & Quick hours -->
                <div class="form-group">
                  <label for="pub-time-input">Hora de partida:</label>
                  <input type="time" id="pub-time-input" class="pub-input" value="07:00" required />
                  <div class="quick-pills-row" id="time-quick-pills">
                    <button type="button" class="pill-shortcut" data-time="06:30">06:30 AM</button>
                    <button type="button" class="pill-shortcut active" data-time="07:00">07:00 AM</button>
                    <button type="button" class="pill-shortcut" data-time="08:00">08:00 AM</button>
                    <button type="button" class="pill-shortcut" data-time="16:30">04:30 PM</button>
                    <button type="button" class="pill-shortcut" data-time="17:30">05:30 PM</button>
                  </div>
                </div>
              </div>
            </section>

            <!-- STEP 3: Vehicle Selection & Management -->
            <section class="builder-section">
              <div class="section-badge-header">
                <span class="step-number">3</span>
                <div>
                  <h2 class="section-title">Tu Vehículo</h2>
                  <p class="section-desc">Elige el auto con el que realizarás la ruta o registra uno nuevo.</p>
                </div>
              </div>

              <!-- Driver Vehicles Visual Selector -->
              <div class="vehicles-visual-wrapper">
                <div class="vehicle-list-radios" id="driver-vehicles-container">
                  <div class="vehicle-loading-placeholder">
                    <span>Cargando tus vehículos verificados...</span>
                  </div>
                </div>

                <!-- Add New Vehicle Form Drawer -->
                <div class="new-vehicle-box" id="new-vehicle-box" style="display: none;">
                  <h3 class="new-vehicle-title">Registrar Nuevo Vehículo</h3>
                  <div class="form-row-3">
                    <div class="form-group">
                      <label for="new-veh-brand">Marca:</label>
                      <input type="text" id="new-veh-brand" class="pub-input" placeholder="Toyota, Mazda, Kia" value="Toyota" />
                    </div>
                    <div class="form-group">
                      <label for="new-veh-model">Modelo:</label>
                      <input type="text" id="new-veh-model" class="pub-input" placeholder="Corolla, CX-30, Rio" value="Corolla" />
                    </div>
                    <div class="form-group">
                      <label for="new-veh-year">Año:</label>
                      <input type="number" id="new-veh-year" class="pub-input" min="1995" max="2027" value="2023" />
                    </div>
                  </div>
                  <div class="form-row-3">
                    <div class="form-group">
                      <label for="new-veh-plate">Placa Salvadoreña:</label>
                      <input type="text" id="new-veh-plate" class="pub-input" placeholder="P-123456" value="P-78219" />
                    </div>
                    <div class="form-group">
                      <label for="new-veh-color">Color:</label>
                      <input type="text" id="new-veh-color" class="pub-input" placeholder="Gris, Blanco, Azul" value="Blanco" />
                    </div>
                    <div class="form-group">
                      <label for="new-veh-capacity">Capacidad Pasajeros:</label>
                      <select id="new-veh-capacity" class="pub-select">
                        <option value="4" selected>4 pasajeros (Sedán/Hatchback)</option>
                        <option value="5">5 pasajeros (Camioneta/SUV)</option>
                        <option value="7">7 pasajeros (Van/Familiar)</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- STEP 4: Seats & Fair Fuel Share Calculator -->
            <section class="builder-section">
              <div class="section-badge-header">
                <span class="step-number">4</span>
                <div>
                  <h2 class="section-title">Asientos y Aporte Justo</h2>
                  <p class="section-desc">Define cuántos cupos ofreces y la contribución económica por asiento.</p>
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="pub-seats-select">Asientos disponibles para pasajeros:</label>
                  <select id="pub-seats-select" class="pub-select">
                    <option value="1">1 asiento</option>
                    <option value="2">2 asientos</option>
                    <option value="3" selected>3 asientos (Recomendado para comodidad)</option>
                    <option value="4">4 asientos</option>
                  </select>
                  <span class="field-hint">Dejar el asiento del medio libre mejora la experiencia.</span>
                </div>

                <div class="form-group">
                  <label for="pub-price-input">Aporte sugerido por asiento ($ USD):</label>
                  <div class="price-input-wrapper">
                    <span class="currency-symbol">$</span>
                    <input 
                      type="number" 
                      id="pub-price-input" 
                      class="pub-input price-field" 
                      step="0.25" 
                      min="1.00" 
                      max="15.00" 
                      value="2.50" 
                      required 
                    />
                    <span class="price-unit-tag">/ persona</span>
                  </div>
                  <span class="field-hint" id="price-hint">Rango recomendado: $2.00 - $3.50 según la distancia.</span>
                </div>
              </div>

              <!-- Fair Share Savings Calculator Widget -->
              <div class="savings-calc-widget">
                <div class="calc-icon-box">⛽</div>
                <div class="calc-info">
                  <span class="calc-label">Aporte total estimado para tu viaje:</span>
                  <div class="calc-amount-row">
                    <strong class="calc-total-usd" id="calc-total-display">$7.50</strong>
                    <span class="calc-formula-sub" id="calc-formula-display">(3 asientos × $2.50)</span>
                  </div>
                  <p class="calc-tip">
                    Cubres hasta el 70% de tus costos de combustible y peajes en esta ruta.
                  </p>
                </div>
              </div>
            </section>

            <!-- STEP 5: Amenities & Trip Notes -->
            <section class="builder-section">
              <div class="section-badge-header">
                <span class="step-number">5</span>
                <div>
                  <h2 class="section-title">Comodidades y Reglas de Convivencia</h2>
                  <p class="section-desc">Selecciona las amenidades disponibles en tu auto.</p>
                </div>
              </div>

              <div class="amenities-toggle-grid">
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="❄️ Con A/C" checked />
                  <span class="chip-content">❄️ Aire Acondicionado</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="🏄 Surf Friendly" checked />
                  <span class="chip-content">🏄 Espacio para Surfboards</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="🧳 Maletero Amplio" checked />
                  <span class="chip-content">🧳 Maletero Amplio</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="🚭 Libre de Humo" checked />
                  <span class="chip-content">🚭 Libre de Humo (No fumadores)</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="🐾 Pet Friendly" />
                  <span class="chip-content">🐾 Pet Friendly (Mascotas)</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="🎵 Música Relajada" checked />
                  <span class="chip-content">🎵 Música Relajada</span>
                </label>
                <label class="amenity-chip-label">
                  <input type="checkbox" name="amenity" value="⏱️ Salida Puntual" checked />
                  <span class="chip-content">⏱️ Salida Puntual</span>
                </label>
              </div>

              <!-- Notes & Additional Comments -->
              <div class="form-group notes-group">
                <label for="pub-desc-input">Notas adicionales para tus pasajeros (opcional):</label>
                <textarea 
                  id="pub-desc-input" 
                  class="pub-textarea" 
                  rows="3" 
                  placeholder="Ej. Salgo puntual desde gasolinera Puma Los Próceres. Espacio para mochilas y tablas. A/C encendido."
                >Salida puntual. Aire acondicionado disponible y espacio para equipaje mediano.</textarea>
              </div>
            </section>

            <!-- Submit Section -->
            <div class="builder-actions-card">
              <div class="terms-guarantee">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="#0F8A8B">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                <span>Tu publicación se sincronizará inmediatamente en vivo con la API y el catálogo de viajes.</span>
              </div>

              <div class="actions-buttons-row">
                <a href="/" class="btn btn-ghost btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg" id="btn-submit-dedicated-publish">
                  <span class="btn-text">🚀 Publicar Viaje en Rutea</span>
                  <span class="btn-spinner" style="display: none;">Publicando en la red...</span>
                </button>
              </div>
            </div>

          </form>
        </div>

        <!-- RIGHT COLUMN: Sticky Live Preview Card -->
        <aside class="publish-preview-column">
          <div class="preview-sticky-box">
            <div class="preview-header">
              <span class="badge badge-sand">👁️ Vista Previa en Vivo</span>
              <h3>Así verán tu viaje los pasajeros</h3>
            </div>

            <!-- Dynamic Live Preview Card -->
            <div class="live-card-container">
              <article class="ride-card glass-card preview-card-live" id="preview-ride-card">
                <div class="card-header">
                  <div class="driver-info">
                    <div class="driver-avatar-circle" id="preview-avatar">
                      <span>C</span>
                    </div>
                    <div class="driver-meta">
                      <div class="driver-name-row">
                        <span class="driver-name" id="preview-driver-name">Tú (Conductor Verificado)</span>
                        <span class="verified-pill">
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="#0F8A8B">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                          </svg>
                          <span>Verificado</span>
                        </span>
                      </div>
                      <div class="driver-subline">
                        <span class="rating-badge">★ 5.0</span>
                        <span class="dot-sep">·</span>
                        <span class="trips-count">Nuevo viaje</span>
                      </div>
                    </div>
                  </div>

                  <span class="badge badge-fresh" id="preview-category-badge">🌊 Ruta Costera</span>
                </div>

                <div class="route-timeline">
                  <div class="timeline-step origin-step">
                    <div class="time-col" id="preview-dep-time">07:00 AM</div>
                    <div class="marker-col">
                      <span class="node-ring origin-ring"></span>
                      <span class="track-line"></span>
                    </div>
                    <div class="location-col">
                      <strong class="location-name" id="preview-origin-text">San Salvador (Multiplaza)</strong>
                      <span class="location-sub">Punto de encuentro seguro</span>
                    </div>
                  </div>

                  <div class="timeline-duration-row">
                    <span class="duration-badge">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span id="preview-duration-badge">45 min directo</span>
                    </span>
                  </div>

                  <div class="timeline-step dest-step">
                    <div class="time-col">Llegada directa</div>
                    <div class="marker-col">
                      <span class="node-ring dest-ring"></span>
                    </div>
                    <div class="location-col">
                      <strong class="location-name" id="preview-dest-text">Playa El Tunco, La Libertad</strong>
                      <span class="location-sub">Destino principal</span>
                    </div>
                  </div>
                </div>

                <!-- Live Notes -->
                <div class="ride-card-note" id="preview-notes-box">
                  <span class="note-quote-mark" aria-hidden="true">“</span>
                  <p class="note-text" id="preview-notes-text">Salida puntual. Aire acondicionado disponible y espacio para equipaje mediano.</p>
                </div>

                <!-- Vehicle and Amenities -->
                <div class="card-vehicle-row">
                  <div class="vehicle-info">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    <span id="preview-vehicle-text">Toyota Corolla 2023 · P-78219</span>
                  </div>

                  <div class="amenities-tags" id="preview-amenities-tags">
                    <span class="amenity-tag">❄️ Con A/C</span>
                    <span class="amenity-tag">🏄 Surf Friendly</span>
                    <span class="amenity-tag">🧳 Maletero Amplio</span>
                  </div>
                </div>

                <!-- Footer with seats and price -->
                <div class="card-footer">
                  <div class="seats-counter">
                    <div class="seats-icons" id="preview-seats-dots">
                      <span class="seat-dot seat-free"></span>
                      <span class="seat-dot seat-free"></span>
                      <span class="seat-dot seat-free"></span>
                    </div>
                    <span class="seats-label">
                      <strong id="preview-seats-num">3</strong> asientos libres
                    </span>
                  </div>

                  <div class="price-action-box">
                    <div class="price-box">
                      <span class="price-amount" id="preview-price-display">$2.50</span>
                      <span class="price-unit">/ persona</span>
                    </div>

                    <button type="button" class="btn btn-primary btn-sm" disabled style="opacity: 0.85;">
                      <span>Reservar Asiento</span>
                    </button>
                  </div>
                </div>
              </article>
            </div>

            <!-- Trust & Safety Highlights -->
            <div class="preview-trust-box">
              <div class="trust-point">
                <span class="tp-icon">🛡️</span>
                <div>
                  <strong>Pasajeros Verificados</strong>
                  <p>Solo usuarios con identidad y teléfono validado pueden solicitar asientos.</p>
                </div>
              </div>
              <div class="trust-point">
                <span class="tp-icon">💬</span>
                <div>
                  <strong>Chat Directo & WhatsApp</strong>
                  <p>Coordinación inmediata de punto de recogida en tiempo real.</p>
                </div>
              </div>
            </div>

          </div>
        </aside>
      </div>

    </div>
  </main>

  <Footer />
  <AuthModal />
</Layout>

<!-- Load Leaflet JS inline -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<style>
  .publish-page-main {
    padding: 2rem 0 4.5rem;
    background: radial-gradient(circle at 10% 20%, rgba(143, 214, 200, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(15, 138, 139, 0.08) 0%, transparent 40%);
    min-height: 85vh;
  }

  .publish-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-slate-muted);
    margin-bottom: 1.25rem;
  }

  .publish-breadcrumb a {
    color: var(--color-ocean);
    text-decoration: none;
    font-weight: 600;
  }

  .publish-breadcrumb a:hover {
    text-decoration: underline;
  }

