    margin: 0;
  }

  .chat-active-container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .active-chat-header {
    padding: 1rem 1.4rem;
    background: white;
    border-bottom: 1px solid rgba(15, 138, 139, 0.12);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .route-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .chat-trip-id {
    font-size: 0.72rem;
    font-family: monospace;
    color: var(--color-slate-light);
  }

  .chat-driver-meta {
    font-size: 0.78rem;
    color: var(--color-slate-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .active-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 380px;
    max-height: 480px;
    scroll-behavior: smooth;
  }

  .chat-msg-row {
    display: flex;
    flex-direction: column;
    max-width: 78%;
  }

  .chat-msg-row.msg-admin {
    align-self: flex-end;
  }

  .chat-msg-row.msg-other {
    align-self: flex-start;
  }

  .msg-bubble-admin {
    background: linear-gradient(135deg, #0B5D67 0%, #0F8A8B 100%);
    color: white;
    border-radius: 14px 14px 2px 14px;
    padding: 0.75rem 1rem;
    box-shadow: 0 4px 12px rgba(11, 93, 103, 0.18);
  }

  .msg-bubble-driver {
    background: #FFFFFF;
    border: 1px solid #8FD6C8;
    color: var(--color-slate);
    border-radius: 14px 14px 14px 2px;
    padding: 0.75rem 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .msg-bubble-passenger {
    background: #FFFFFF;
    border: 1px solid rgba(15, 138, 139, 0.15);
    color: var(--color-slate);
    border-radius: 14px 14px 14px 2px;
    padding: 0.75rem 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .msg-sender-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    margin-bottom: 0.3rem;
    font-weight: 700;
  }

  .msg-sender-admin {
    color: #8FD6C8;
  }

  .msg-sender-driver {
    color: #0F8A8B;
  }

  .msg-sender-passenger {
    color: var(--color-slate);
  }

  .msg-body-text {
    font-size: 0.88rem;
    line-height: 1.45;
    word-break: break-word;
  }

  .msg-footer-time {
    font-size: 0.68rem;
    margin-top: 0.35rem;
    text-align: right;
    opacity: 0.8;
  }

  .chat-quick-replies {
    padding: 0.5rem 1rem;
    background: #F8FAFC;
    border-top: 1px solid rgba(15, 138, 139, 0.08);
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
  }

  .reply-chip {
    background: white;
    border: 1px solid rgba(15, 138, 139, 0.25);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.7rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-fast);
  }

  .reply-chip:hover {
    background: var(--color-primary);
    color: white;
  }

  .active-chat-composer {
    padding: 0.9rem 1.2rem;
    background: white;
    border-top: 1px solid rgba(15, 138, 139, 0.12);
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .composer-input {
    flex: 1;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgba(15, 138, 139, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    outline: none;
    transition: var(--transition-fast);
  }

  .composer-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(11, 93, 103, 0.12);
  }

  .composer-send-btn {
    border-radius: var(--radius-full);
    padding: 0.7rem 1.3rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (max-width: 860px) {
    .admin-chat-grid {
      grid-template-columns: 1fr;
      max-height: none;
    }
    .chat-threads-sidebar {
      max-height: 280px;
    }
  }
</style>

<script>
  import { 
    authService, 
    usuariosService, 
    rutasService, 
    viajesService,
    mensajeriaService,
    StompChatClient,
    type UsuarioResponse,
    type RutaResponse,
    type ViajeResponse,
    type ConversacionAdminResponse,
    type MensajeResponse
  } from '../services';

  // State
  let usersList: UsuarioResponse[] = [];
  let routesList: RutaResponse[] = [];
  let ridesList: ViajeResponse[] = [];
  let conversationsList: ConversacionAdminResponse[] = [];

  let activeConversationId = '';
  let activeConversationMessages: MensajeResponse[] = [];
  let stompClient: StompChatClient | null = null;
  let activeRoomUnsubscribe: (() => void) | null = null;
  let threadsFilterMode: 'ALL' | 'ACTIVE' = 'ALL';

  let selectedUserIdForRoles = '';
  let selectedUserIdForEdit = '';
  let editingRouteId = '';

  // DOM Elements
  const authGate = document.getElementById('admin-auth-gate');
  const dashboardContent = document.getElementById('admin-dashboard-content');
  const adminRolePill = document.getElementById('admin-user-pill');
  const btnAdminGateLogin = document.getElementById('btn-admin-gate-login');
  const btnRefreshData = document.getElementById('btn-refresh-admin-data');
  const btnAdminLogout = document.getElementById('btn-admin-logout');

  // KPI Elements
  const kpiTotalUsers = document.getElementById('kpi-total-users');
  const kpiDriversRatio = document.getElementById('kpi-drivers-ratio');
  const kpiTotalRides = document.getElementById('kpi-total-rides');
  const kpiActiveRides = document.getElementById('kpi-active-rides');
  const kpiTotalRoutes = document.getElementById('kpi-total-routes');
  const kpiActiveRoutes = document.getElementById('kpi-active-routes');

  // Badge counts
  const badgeUsersCount = document.getElementById('badge-users-count');
  const badgeRoutesCount = document.getElementById('badge-routes-count');
  const badgeRidesCount = document.getElementById('badge-rides-count');

  // Tables
  const usersTableBody = document.getElementById('users-table-body');
  const routesTableBody = document.getElementById('routes-table-body');
  const ridesTableBody = document.getElementById('rides-table-body');

  // Search & Filters
  const userSearchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
  const userRoleFilter = document.getElementById('user-role-filter') as HTMLSelectElement | null;
  const rideSearchInput = document.getElementById('ride-search-input') as HTMLInputElement | null;
  const rideStatusFilter = document.getElementById('ride-status-filter') as HTMLSelectElement | null;

  // Modals
  const modalRoles = document.getElementById('modal-roles');
  const btnCloseRolesModal = document.getElementById('btn-close-roles-modal');
  const btnCancelRoles = document.getElementById('btn-cancel-roles');
  const formUpdateRoles = document.getElementById('form-update-roles');
  const modalRolesUsername = document.getElementById('modal-roles-username');
  const modalRolesUserId = document.getElementById('modal-roles-user-id') as HTMLInputElement | null;

  const modalEditUser = document.getElementById('modal-edit-user');
  const btnCloseEditUserModal = document.getElementById('btn-close-edit-user-modal');
  const btnCancelEditUser = document.getElementById('btn-cancel-edit-user');
  const formEditUser = document.getElementById('form-edit-user');
  const editUserNombre = document.getElementById('edit-user-nombre') as HTMLInputElement | null;
  const editUserApellido = document.getElementById('edit-user-apellido') as HTMLInputElement | null;
  const editUserTelefono = document.getElementById('edit-user-telefono') as HTMLInputElement | null;
  const modalEditUserId = document.getElementById('modal-edit-user-id') as HTMLInputElement | null;

  const modalRoute = document.getElementById('modal-route');
  const btnOpenCreateRoute = document.getElementById('btn-open-create-route');
  const btnCloseRouteModal = document.getElementById('btn-close-route-modal');
  const btnCancelRoute = document.getElementById('btn-cancel-route');
  const formRoute = document.getElementById('form-route');
  const modalRouteTitle = document.getElementById('modal-route-title');
  const modalRouteId = document.getElementById('modal-route-id') as HTMLInputElement | null;
  const routeNombre = document.getElementById('route-nombre') as HTMLInputElement | null;
  const routeDescripcion = document.getElementById('route-descripcion') as HTMLTextAreaElement | null;

  // Messaging & Chat DOM Elements
  const badgeMessagesCount = document.getElementById('badge-messages-count');
  const wsStatusBadge = document.getElementById('ws-status-badge');
  const wsPulseDot = document.getElementById('ws-pulse-dot');
  const wsStatusLabel = document.getElementById('ws-status-label');
  const btnRefreshMessages = document.getElementById('btn-refresh-messages');
  const btnOpenNewTicket = document.getElementById('btn-open-new-ticket');
  const btnEmptyOpenChat = document.getElementById('btn-empty-open-chat');

  const chatSearchInput = document.getElementById('chat-search-input') as HTMLInputElement | null;
  const filterThreadsAll = document.getElementById('filter-threads-all');
  const filterThreadsActive = document.getElementById('filter-threads-active');
  const chatThreadsList = document.getElementById('chat-threads-list');

  const chatEmptyState = document.getElementById('chat-empty-state');
  const chatActiveContainer = document.getElementById('chat-active-container');
  const chatHeaderRoute = document.getElementById('chat-header-route');
  const chatHeaderTripId = document.getElementById('chat-header-trip-id');
  const chatHeaderDriver = document.getElementById('chat-header-driver');
  const chatHeaderParticipants = document.getElementById('chat-header-participants');
  const chatLiveBadge = document.getElementById('chat-live-badge');
  const chatMessagesContainer = document.getElementById('chat-messages-container');

  const formChatSend = document.getElementById('form-chat-send');
  const chatMessageInput = document.getElementById('chat-message-input') as HTMLInputElement | null;
  const btnChatSend = document.getElementById('btn-chat-send');

  const modalNewTicket = document.getElementById('modal-new-ticket');
  const btnCloseTicketModal = document.getElementById('btn-close-ticket-modal');
  const btnCancelTicket = document.getElementById('btn-cancel-ticket');
  const formOpenTicket = document.getElementById('form-open-ticket');
  const selectTicketViaje = document.getElementById('select-ticket-viaje') as HTMLSelectElement | null;
  const ticketInitialMsg = document.getElementById('ticket-initial-msg') as HTMLTextAreaElement | null;

  // Alert Banner
  const adminAlertBanner = document.getElementById('admin-alert-banner');
  const adminAlertText = document.getElementById('admin-alert-text');
  const btnCloseAdminAlert = document.getElementById('btn-close-admin-alert');

  function showAdminNotice(msg: string, isError: boolean = false) {
    if (!adminAlertBanner || !adminAlertText) return;
    adminAlertText.textContent = msg;
    adminAlertBanner.style.background = isError ? '#FDE8E8' : '#DEF7EC';
    adminAlertBanner.style.color = isError ? '#9B1C1C' : '#03543F';
    adminAlertBanner.style.borderColor = isError ? '#F98080' : '#31C48D';
    adminAlertBanner.style.display = 'flex';
    setTimeout(() => {
      adminAlertBanner.style.display = 'none';
    }, 5500);
  }

  btnCloseAdminAlert?.addEventListener('click', () => {
    if (adminAlertBanner) adminAlertBanner.style.display = 'none';
  });

  // 1. Verificación de Autenticación de Administrador
  async function checkAdminAuth() {
    const user = authService.getStoredUser();
    const isAdmin = Boolean(user && user.roles && user.roles.includes('ADMIN' as any));

    if (isAdmin) {
      if (adminRolePill) adminRolePill.textContent = `Sesión: ${user?.nombre} (ADMIN)`;
      if (authGate) authGate.style.display = 'none';
      if (dashboardContent) dashboardContent.style.display = 'block';
      loadAllAdminData();
    } else {
      if (adminRolePill) adminRolePill.textContent = 'Acceso Denegado (No Admin)';
      if (authGate) authGate.style.display = 'block';
      if (dashboardContent) dashboardContent.style.display = 'none';
    }
  }

  btnAdminGateLogin?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('request-auth-required', {
      detail: { action: 'acceder al panel de administración', message: 'Inicia sesión con la cuenta de administrador.' }
    }));
  });

  window.addEventListener('auth-state-changed', () => {
    checkAdminAuth();
  });

  // 2. Cargar Todos los Datos desde la API
  async function loadAllAdminData() {
    try {
      const [users, routes, rides, conversations] = await Promise.all([
        usuariosService.getAllUsuarios().catch(() => []),
        rutasService.getAllRutas().catch(() => rutasService.getRutas().catch(() => [])),
        viajesService.buscarViajes().catch(() => []),
        mensajeriaService.listarTodasAdmin().catch(() => [])
      ]);

      usersList = users;
      routesList = routes;
      ridesList = rides;
      conversationsList = conversations;

      updateKpis();
      renderUsersTable();
      renderRoutesTable();
      renderRidesTable();
      renderConversationsList();
      initWebSocketChat();
    } catch (e: any) {
      showAdminNotice('Error al sincronizar datos con el servidor: ' + (e?.message || ''), true);
    }
  }

  btnRefreshData?.addEventListener('click', async () => {
    showAdminNotice('Sincronizando información en vivo desde la base de datos...');
    await loadAllAdminData();
  });

  btnAdminLogout?.addEventListener('click', async () => {
    try {
      if (btnAdminLogout) {
        btnAdminLogout.setAttribute('disabled', 'true');
        btnAdminLogout.innerHTML = `<span>Cerrando...</span>`;
      }
      if (stompClient) {
        stompClient.disconnect();
        stompClient = null;
      }
      showAdminNotice('Cerrando sesión en el servidor y eliminando cookies...');
      const res = await authService.logout();
      showAdminNotice(res?.mensaje || 'Sesión finalizada. Cookies eliminadas con éxito.');
    } catch (err: any) {
      console.warn('Error en logout admin:', err);
      showAdminNotice('Sesión finalizada localmente.', false);
    } finally {
      if (btnAdminLogout) {
        btnAdminLogout.removeAttribute('disabled');
        btnAdminLogout.innerHTML = `
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Cerrar Sesión</span>
        `;
      }
      checkAdminAuth();
    }
  });

  // 3. Métricas y KPIs
  function updateKpis() {
    if (kpiTotalUsers) kpiTotalUsers.textContent = String(usersList.length);
    const conductorsCount = usersList.filter(u => u.roles?.includes('CONDUCTOR' as any)).length;
    if (kpiDriversRatio) kpiDriversRatio.textContent = `${conductorsCount} conductores verificados`;

    if (kpiTotalRides) kpiTotalRides.textContent = String(ridesList.length);
    const publishedRides = ridesList.filter(r => r.estado === 'PUBLICADO').length;
    if (kpiActiveRides) kpiActiveRides.textContent = `${publishedRides} viajes en estado PUBLICADO`;

    if (kpiTotalRoutes) kpiTotalRoutes.textContent = String(routesList.length);
    const activeRoutes = routesList.filter(r => r.activo).length;
    if (kpiActiveRoutes) kpiActiveRoutes.textContent = `${activeRoutes} rutas activas en catálogo`;

    if (badgeUsersCount) badgeUsersCount.textContent = String(usersList.length);
    if (badgeRoutesCount) badgeRoutesCount.textContent = String(routesList.length);
    if (badgeRidesCount) badgeRidesCount.textContent = String(ridesList.length);
  }

  // 4. Render Tabla de Usuarios
  function renderUsersTable() {
    if (!usersTableBody) return;
    const search = userSearchInput?.value.toLowerCase().trim() || '';
    const roleFilter = userRoleFilter?.value || 'ALL';

    const filtered = usersList.filter(u => {
      const matchSearch = !search || 
        `${u.nombre} ${u.apellido}`.toLowerCase().includes(search) ||
        u.correo.toLowerCase().includes(search) ||
        (u.telefono && u.telefono.includes(search));

      const matchRole = roleFilter === 'ALL' || u.roles?.includes(roleFilter as any);
      return matchSearch && matchRole;
    });

    if (filtered.length === 0) {
      usersTableBody.innerHTML = `<tr><td colspan="7" class="table-loading-row">No se encontraron usuarios coincidentes.</td></tr>`;
      return;
    }

    usersTableBody.innerHTML = filtered.map(u => {
      const initial = (u.nombre || 'U').charAt(0).toUpperCase();
      const rolesBadges = (u.roles || []).map(r => {
        const cls = r === 'ADMIN' ? 'badge-admin' : r === 'CONDUCTOR' ? 'badge-conductor' : r === 'CLIENTE' ? 'badge-cliente' : 'badge-usuario';
        return `<span class="role-tag-badge ${cls}">${r}</span>`;
      }).join(' ');

      const statusBadge = u.estado === 'ACTIVO' 
        ? `<span class="status-tag active">ACTIVO</span>` 
        : `<span class="status-tag inactive">INACTIVO</span>`;

      const regDate = u.creadoEn ? new Date(u.creadoEn).toLocaleDateString('es-SV') : 'Reciente';

      return `
        <tr data-user-id="${u.id}">
          <td>
            <div class="user-cell">
              <div class="user-avatar-circle">${initial}</div>
              <div class="user-name-meta">
                <strong>${u.nombre} ${u.apellido}</strong>
                <span>ID: ${u.id.substring(0, 8)}...</span>
              </div>
            </div>
          </td>
          <td><code>${u.correo}</code></td>
          <td>${u.telefono || '<span style="color:#94a3b8;">Sin teléfono</span>'}</td>
          <td>${rolesBadges}</td>
          <td>${statusBadge}</td>
          <td>${regDate}</td>
          <td>
            <div class="table-actions-cell">
              <button type="button" class="btn-table-action btn-manage-roles" data-id="${u.id}" data-name="${u.nombre} ${u.apellido}" title="Asignar Roles">
                🛡️ Roles
              </button>
              <button type="button" class="btn-table-action btn-edit-user" data-id="${u.id}" title="Editar Perfil">
                ✏️ Editar
              </button>
              <button type="button" class="btn-table-action btn-danger-action btn-delete-user" data-id="${u.id}" data-name="${u.nombre}" title="Eliminar Usuario">
                🗑️
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Bind action buttons
    usersTableBody.querySelectorAll('.btn-manage-roles').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const name = (e.currentTarget as HTMLElement).getAttribute('data-name') || '';
        openRolesModal(id, name);
      });
    });

    usersTableBody.querySelectorAll('.btn-edit-user').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        openEditUserModal(id);
      });
    });

    usersTableBody.querySelectorAll('.btn-delete-user').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const name = (e.currentTarget as HTMLElement).getAttribute('data-name') || '';
        if (confirm(`¿Estás seguro de eliminar al usuario ${name}? Esta acción no se puede deshacer.`)) {
          try {
            await usuariosService.deleteUsuario(id);
            showAdminNotice(`Usuario ${name} eliminado exitosamente.`);
            usersList = usersList.filter(u => u.id !== id);
            renderUsersTable();
            updateKpis();
          } catch (err: any) {
            showAdminNotice('Error al eliminar usuario: ' + (err?.data?.message || err?.message), true);
          }
        }
      });
    });
  }

  userSearchInput?.addEventListener('input', renderUsersTable);
  userRoleFilter?.addEventListener('change', renderUsersTable);

  // 5. Modal de Roles
  function openRolesModal(userId: string, userName: string) {
    selectedUserIdForRoles = userId;
    if (modalRolesUsername) modalRolesUsername.textContent = userName;
    if (modalRolesUserId) modalRolesUserId.value = userId;

    const user = usersList.find(u => u.id === userId);
    const currentRoles = user?.roles || [];

    document.querySelectorAll('input[name="admin_role"]').forEach(cb => {
      const input = cb as HTMLInputElement;
      input.checked = currentRoles.includes(input.value as any);
    });

    if (modalRoles) modalRoles.style.display = 'flex';
  }

  function closeRolesModal() {
    if (modalRoles) modalRoles.style.display = 'none';
  }

  btnCloseRolesModal?.addEventListener('click', closeRolesModal);
  btnCancelRoles?.addEventListener('click', closeRolesModal);

  formUpdateRoles?.addEventListener('submit', async () => {
    const checked = Array.from(document.querySelectorAll('input[name="admin_role"]:checked'))
      .map(el => (el as HTMLInputElement).value);

    if (checked.length === 0) {
      alert('El usuario debe tener al menos un rol.');
      return;
    }

    try {
      await usuariosService.changeRoles(selectedUserIdForRoles, checked);
      showAdminNotice('Roles actualizados exitosamente.');
      closeRolesModal();
      // Actualizar lista local
      const u = usersList.find(x => x.id === selectedUserIdForRoles);
      if (u) u.roles = checked as any;
      renderUsersTable();
      updateKpis();
    } catch (err: any) {
      alert('Error al actualizar roles: ' + (err?.data?.message || err?.message));
    }
  });

  // 6. Modal de Editar Perfil
  function openEditUserModal(userId: string) {
    selectedUserIdForEdit = userId;
    const user = usersList.find(u => u.id === userId);
    if (!user) return;

    if (modalEditUserId) modalEditUserId.value = user.id;
    if (editUserNombre) editUserNombre.value = user.nombre;
    if (editUserApellido) editUserApellido.value = user.apellido;
    if (editUserTelefono) editUserTelefono.value = user.telefono || '+503 ';

    if (modalEditUser) modalEditUser.style.display = 'flex';
  }

  function closeEditUserModal() {
    if (modalEditUser) modalEditUser.style.display = 'none';
  }

  btnCloseEditUserModal?.addEventListener('click', closeEditUserModal);
  btnCancelEditUser?.addEventListener('click', closeEditUserModal);

  formEditUser?.addEventListener('submit', async () => {
    const nombre = editUserNombre?.value.trim() || '';
    const apellido = editUserApellido?.value.trim() || '';
    const telefono = editUserTelefono?.value.trim() || '';

    if (!nombre || !apellido) {
      alert('Nombre y apellido son obligatorios.');
      return;
    }

    try {
      await usuariosService.updateUsuario(selectedUserIdForEdit, { nombre, apellido, telefono });
      showAdminNotice('Perfil de usuario actualizado exitosamente.');
      closeEditUserModal();
      const u = usersList.find(x => x.id === selectedUserIdForEdit);
      if (u) {
        u.nombre = nombre;
        u.apellido = apellido;
        u.telefono = telefono;
      }
      renderUsersTable();
    } catch (err: any) {
      alert('Error al modificar usuario: ' + (err?.data?.message || err?.message));
    }
  });

  // 7. Render Tabla de Rutas
  function renderRoutesTable() {
    if (!routesTableBody) return;

    if (routesList.length === 0) {
      routesTableBody.innerHTML = `<tr><td colspan="5" class="table-loading-row">No hay rutas en el catálogo actualmente.</td></tr>`;
      return;
    }

    routesTableBody.innerHTML = routesList.map(r => {
      const statusBadge = r.activo 
        ? `<span class="status-tag active">ACTIVA</span>` 
        : `<span class="status-tag inactive">INACTIVA</span>`;

      const regDate = r.creadoEn ? new Date(r.creadoEn).toLocaleDateString('es-SV') : 'Oficial';

      return `
        <tr data-route-id="${r.id}">
          <td><strong>${r.nombre}</strong></td>
          <td style="max-width:320px;color:#475569;">${r.descripcion}</td>
          <td>${statusBadge}</td>
          <td>${regDate}</td>
          <td>
            <div class="table-actions-cell">
              <button type="button" class="btn-table-action btn-toggle-route-status" data-id="${r.id}" data-active="${r.activo}">
                ${r.activo ? '⏸️ Desactivar' : '▶️ Activar'}
              </button>
              <button type="button" class="btn-table-action btn-edit-route" data-id="${r.id}" data-name="${r.nombre}" data-desc="${r.descripcion}">
                ✏️ Editar
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    routesTableBody.querySelectorAll('.btn-toggle-route-status').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const currentlyActive = (e.currentTarget as HTMLElement).getAttribute('data-active') === 'true';
        try {
          await rutasService.cambiarEstadoRuta(id, !currentlyActive);
          showAdminNotice(`Estado de ruta actualizado a ${!currentlyActive ? 'Activa' : 'Inactiva'}.`);
          const route = routesList.find(x => x.id === id);
          if (route) route.activo = !currentlyActive;
          renderRoutesTable();
          updateKpis();
        } catch (err: any) {
          showAdminNotice('Error al cambiar estado de ruta: ' + (err?.data?.message || err?.message), true);
        }
      });
    });

    routesTableBody.querySelectorAll('.btn-edit-route').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const name = (e.currentTarget as HTMLElement).getAttribute('data-name') || '';
        const desc = (e.currentTarget as HTMLElement).getAttribute('data-desc') || '';
        openRouteModal(id, name, desc);
      });
    });
  }

  // 8. Modal de Crear / Editar Ruta
  btnOpenCreateRoute?.addEventListener('click', () => {
    openRouteModal('', '', '');
  });

  function openRouteModal(id: string, name: string, desc: string) {
    editingRouteId = id;
    if (modalRouteId) modalRouteId.value = id;
    if (routeNombre) routeNombre.value = name;
    if (routeDescripcion) routeDescripcion.value = desc;

    if (modalRouteTitle) {
      modalRouteTitle.textContent = id ? '✏️ Modificar Ruta Oficial' : '🛣️ Crear Nueva Ruta Oficial';
    }

    if (modalRoute) modalRoute.style.display = 'flex';
  }

  function closeRouteModal() {
    if (modalRoute) modalRoute.style.display = 'none';
  }

  btnCloseRouteModal?.addEventListener('click', closeRouteModal);
  btnCancelRoute?.addEventListener('click', closeRouteModal);

  formRoute?.addEventListener('submit', async () => {
    const nombre = routeNombre?.value.trim() || '';
    const descripcion = routeDescripcion?.value.trim() || '';

    if (!nombre || !descripcion) {
      alert('Nombre y descripción de la ruta son requeridos.');
      return;
    }

    try {
      if (editingRouteId) {
        await rutasService.actualizarRuta(editingRouteId, { nombre, descripcion });
        showAdminNotice('Ruta oficial actualizada exitosamente.');
      } else {
        await rutasService.crearRuta({ nombre, descripcion });
        showAdminNotice('Nueva ruta agregada al catálogo oficial.');
      }
      closeRouteModal();
      await loadAllAdminData();
    } catch (err: any) {
      alert('Error con la ruta: ' + (err?.data?.message || err?.message));
    }
  });

  // 9. Render Tabla de Viajes
  function renderRidesTable() {
    if (!ridesTableBody) return;
    const search = rideSearchInput?.value.toLowerCase().trim() || '';
    const statusFilter = rideStatusFilter?.value || 'ALL';

    const filtered = ridesList.filter(r => {
      const matchSearch = !search ||
        (r.origenNombre && r.origenNombre.toLowerCase().includes(search)) ||
        (r.destinoNombre && r.destinoNombre.toLowerCase().includes(search));

      const matchStatus = statusFilter === 'ALL' || r.estado === statusFilter;
      return matchSearch && matchStatus;
    });

    if (filtered.length === 0) {
      ridesTableBody.innerHTML = `<tr><td colspan="7" class="table-loading-row">No se encontraron viajes registrados.</td></tr>`;
      return;
    }

    ridesTableBody.innerHTML = filtered.map(r => {
      let statusClass = 'published';
      if (r.estado === 'CANCELADO') statusClass = 'inactive';
      if (r.estado === 'FINALIZADO') statusClass = 'active';

      return `
        <tr data-ride-id="${r.id}">
          <td>
            <strong>${r.origenNombre}</strong>
            <span style="color:#64748b;font-size:12px;display:block;">➔ ${r.destinoNombre}</span>
          </td>
          <td>
            <span>${r.fechaSalida}</span>
            <span style="color:#0F8A8B;font-weight:700;display:block;font-size:12px;">${r.horaSalida}</span>
          </td>
          <td>
            <strong>${r.cuposDisponibles ?? r.cuposTotales}</strong> / ${r.cuposTotales} libres
          </td>
          <td>
            <strong style="color:#0B5D67;">$${Number(r.tarifaAproximada).toFixed(2)}</strong>
          </td>
          <td>
            <span class="status-tag ${statusClass}">${r.estado}</span>
          </td>
          <td>
            <code style="font-size:11px;">${r.id.substring(0, 8)}...</code>
          </td>
          <td>
            <div class="table-actions-cell">
              <select class="admin-filter-select select-change-ride-status" data-id="${r.id}" style="padding:0.25rem 0.5rem;font-size:11px;">
                <option value="" disabled selected>Cambiar estado...</option>
                <option value="PUBLICADO">PUBLICADO</option>
                <option value="EN_CURSO">EN_CURSO</option>
                <option value="FINALIZADO">FINALIZADO</option>
                <option value="CANCELADO">CANCELAR VIAJE</option>
              </select>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    ridesTableBody.querySelectorAll('.select-change-ride-status').forEach(select => {
      select.addEventListener('change', async (e) => {
        const target = e.currentTarget as HTMLSelectElement;
        const rideId = target.getAttribute('data-id') || '';
        const nuevoEstado = target.value;
        if (!nuevoEstado) return;

        if (confirm(`¿Confirmas cambiar el estado del viaje a ${nuevoEstado}?`)) {
          try {
            await viajesService.cambiarEstado(rideId, nuevoEstado);
            showAdminNotice(`Estado del viaje actualizado a ${nuevoEstado}.`);
            const ride = ridesList.find(x => x.id === rideId);
            if (ride) ride.estado = nuevoEstado as any;
            renderRidesTable();
            updateKpis();
          } catch (err: any) {
            showAdminNotice('Error al cambiar estado del viaje: ' + (err?.data?.message || err?.message), true);
          }
        }
      });
    });
  }

  rideSearchInput?.addEventListener('input', renderRidesTable);
  rideStatusFilter?.addEventListener('change', renderRidesTable);

  // ========================================================
  // 9. MÓDULO DE MENSAJERÍA Y CHAT EN TIEMPO REAL (ADMIN)
  // ========================================================

  function escapeHtml(str: string): string {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatMessageTime(isoString: string): string {
    if (!isoString) return '';
    try {
      const d = new Date(isoString);
      return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    } catch {
      return '';
    }
  }

  function formatTimeAgo(isoString: string): string {
    if (!isoString) return '';
    try {
      const d = new Date(isoString);
      const now = new Date();
      const diffMs = now.getTime() - d.getTime();
      const diffMins = Math.floor(diffMs / (1000 * 60));
      if (diffMins < 1) return 'Ahora';
      if (diffMins < 60) return `${diffMins}m`;
      const diffHours = Math.floor(diffMins / 60);
      if (diffHours < 24) return `${diffHours}h`;
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
    } catch {
      return '';
    }
  }

  function scrollToBottom() {
    if (chatMessagesContainer) {
      chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
    }
  }

  function initWebSocketChat() {
    const token = authService.getToken();
    if (!token) return;

    if (stompClient) {
      stompClient.disconnect();
    }

    stompClient = mensajeriaService.crearWebSocketClient(token, (status) => {
      if (!wsStatusLabel || !wsPulseDot) return;
      if (status === 'CONNECTED') {
        wsStatusLabel.textContent = '🟢 STOMP En Vivo';
        wsPulseDot.className = 'status-pulse-dot';
        if (chatLiveBadge) chatLiveBadge.textContent = '🟢 Conexión Activa';
      } else if (status === 'CONNECTING') {
        wsStatusLabel.textContent = '🟡 Conectando STOMP...';
        wsPulseDot.className = 'status-pulse-dot connecting';
        if (chatLiveBadge) chatLiveBadge.textContent = '🟡 Conectando...';
      } else {
        wsStatusLabel.textContent = '🔴 Desconectado (Sondeo)';
        wsPulseDot.className = 'status-pulse-dot disconnected';
        if (chatLiveBadge) chatLiveBadge.textContent = '⚪ Modo Sondeo';
      }
    });

    stompClient.connect();

    // Suscribirse al canal global para actualizar la lista de conversaciones
    stompClient.subscribe('/topic/conversaciones', (msg: MensajeResponse) => {
      const existing = conversationsList.find(c => c.id === msg.conversacionId);
      if (existing) {
        existing.ultimoMensaje = msg.contenido;
        existing.ultimoMensajeEn = msg.enviadoEn;
        existing.totalMensajes = (Number(existing.totalMensajes) || 0) + 1;
      } else {
        mensajeriaService.listarTodasAdmin().then(list => {
          conversationsList = list;
          renderConversationsList();
        }).catch(() => {});
      }
      renderConversationsList();

      if (activeConversationId === msg.conversacionId) {
        if (!activeConversationMessages.some(m => m.id === msg.id)) {
          activeConversationMessages.push(msg);
          appendMessageToDom(msg);
          scrollToBottom();
        }
      }
    });
  }

  function renderConversationsList() {
    if (!chatThreadsList) return;

    const query = (chatSearchInput?.value || '').trim().toLowerCase();
    let filtered = conversationsList.filter(c => {
      const matchesSearch = !query || 
        (c.origen && c.origen.toLowerCase().includes(query)) ||
        (c.destino && c.destino.toLowerCase().includes(query)) ||
        (c.conductorNombre && c.conductorNombre.toLowerCase().includes(query)) ||
        (c.ultimoMensaje && c.ultimoMensaje.toLowerCase().includes(query));

      const matchesFilter = threadsFilterMode === 'ALL' || (Number(c.totalMensajes) > 0);
      return matchesSearch && matchesFilter;
    });

    if (badgeMessagesCount) {
      badgeMessagesCount.textContent = String(conversationsList.length);
    }

    const countBadge = document.getElementById('threads-total-count');
    if (countBadge) countBadge.textContent = String(conversationsList.length);

    if (filtered.length === 0) {
      chatThreadsList.innerHTML = `
        <div class="chat-thread-empty">
          <p>No se encontraron conversaciones activas.</p>
          <button type="button" class="btn btn-outline btn-xs" id="btn-quick-open-first-chat">
            + Iniciar Conversación de Viaje
          </button>
        </div>
      `;
      document.getElementById('btn-quick-open-first-chat')?.addEventListener('click', openTicketModal);
      return;
    }

    chatThreadsList.innerHTML = filtered.map(c => {
      const isActive = c.id === activeConversationId;
      const timeFormatted = formatTimeAgo(c.ultimoMensajeEn || c.creadoEn);
      return `
        <div class="thread-card ${isActive ? 'active' : ''}" data-conv-id="${c.id}">
          <div class="thread-card-top">
            <span class="thread-route-title" title="${c.origen} ➔ ${c.destino}">${c.origen} ➔ ${c.destino}</span>
            <span class="thread-time">${timeFormatted}</span>
          </div>
          <div class="thread-driver-row">
            <span>🚗 ${c.conductorNombre || 'Conductor'}</span>
          </div>
          <div class="thread-preview-row">
            <span class="thread-preview-text">${escapeHtml(c.ultimoMensaje || 'Sin mensajes')}</span>
            <span class="thread-count-badge" title="${c.totalMensajes} mensajes">${c.totalMensajes || 0}</span>
          </div>
        </div>
      `;
    }).join('');

    chatThreadsList.querySelectorAll('.thread-card').forEach(card => {
      card.addEventListener('click', () => {
        const convId = card.getAttribute('data-conv-id');
        if (convId) openConversation(convId);
      });
    });
  }

  async function openConversation(convId: string) {
    activeConversationId = convId;
    renderConversationsList();

    const conv = conversationsList.find(c => c.id === convId);
    if (!conv) return;

    if (chatEmptyState) chatEmptyState.style.display = 'none';
    if (chatActiveContainer) chatActiveContainer.style.display = 'flex';

    if (chatHeaderRoute) chatHeaderRoute.textContent = `${conv.origen} ➔ ${conv.destino}`;
    if (chatHeaderTripId) chatHeaderTripId.textContent = `Viaje: #${conv.viajeId.slice(0, 8)}`;
    if (chatHeaderDriver) chatHeaderDriver.textContent = `Conductor: ${conv.conductorNombre || 'Verificado'}`;
    if (chatHeaderParticipants) {
      const count = conv.participantesIds?.length || 1;
      chatHeaderParticipants.textContent = `${count} participante${count === 1 ? '' : 's'}`;
    }

    if (chatMessagesContainer) {
      chatMessagesContainer.innerHTML = '<div class="chat-thread-loading">Cargando mensajes...</div>';
    }

    try {
      const mensajes = await mensajeriaService.obtenerMensajes(convId);
      activeConversationMessages = mensajes;
      renderMessages(mensajes);
      scrollToBottom();
    } catch (err) {
      if (chatMessagesContainer) {
        chatMessagesContainer.innerHTML = '<div class="chat-thread-loading">Error al cargar historial de mensajes.</div>';
      }
    }

    // Suscribir a la sala de conversación específica
    if (activeRoomUnsubscribe) {
      activeRoomUnsubscribe();
      activeRoomUnsubscribe = null;
    }
    if (stompClient) {
      activeRoomUnsubscribe = stompClient.subscribe(`/topic/conversaciones/${convId}`, (msg: MensajeResponse) => {
        if (!activeConversationMessages.some(m => m.id === msg.id)) {
          activeConversationMessages.push(msg);
          appendMessageToDom(msg);
          scrollToBottom();
        }
      });
    }
  }

  function renderMessages(mensajes: MensajeResponse[]) {
    if (!chatMessagesContainer) return;
    if (mensajes.length === 0) {
      chatMessagesContainer.innerHTML = `
        <div class="chat-thread-empty">
          <p>No hay mensajes en esta conversación todavía.</p>
          <span style="font-size: 0.8rem; opacity: 0.75;">Sé el primero en enviar un mensaje a los participantes del viaje.</span>
        </div>
      `;
      return;
    }
    chatMessagesContainer.innerHTML = '';
    mensajes.forEach(msg => appendMessageToDom(msg));
  }

  function appendMessageToDom(msg: MensajeResponse) {
    if (!chatMessagesContainer) return;
    const isMsgEmptyHolder = chatMessagesContainer.querySelector('.chat-thread-empty');
    if (isMsgEmptyHolder) chatMessagesContainer.innerHTML = '';

    const isAdmin = msg.remitenteRol === 'ADMIN';
    const isConductor = msg.remitenteRol === 'CONDUCTOR';

    let roleLabel = '👤 Pasajero';
    let senderClass = 'msg-sender-passenger';
    let bubbleClass = 'msg-bubble-passenger';

    if (isAdmin) {
      roleLabel = '🛡️ Soporte Admin';
      senderClass = 'msg-sender-admin';
      bubbleClass = 'msg-bubble-admin';
    } else if (isConductor) {
      roleLabel = '🚗 Conductor';
      senderClass = 'msg-sender-driver';
      bubbleClass = 'msg-bubble-driver';
    }

    const timeStr = formatMessageTime(msg.enviadoEn);

    const row = document.createElement('div');
    row.className = `chat-msg-row ${isAdmin ? 'msg-admin' : 'msg-other'}`;
    row.setAttribute('data-msg-id', msg.id);

    row.innerHTML = `
      <div class="${bubbleClass}">
        <div class="msg-sender-meta">
          <span class="${senderClass}">${roleLabel}</span>
          ${!isAdmin && msg.remitenteNombre ? `<span style="opacity: 0.8;">· ${escapeHtml(msg.remitenteNombre)}</span>` : ''}
        </div>
        <div class="msg-body-text">${escapeHtml(msg.contenido)}</div>
        <div class="msg-footer-time">${timeStr}</div>
      </div>
    `;

    chatMessagesContainer.appendChild(row);
  }

  async function sendMessage() {
    if (!activeConversationId || !chatMessageInput) return;
    const text = chatMessageInput.value.trim();
    if (!text) return;

    chatMessageInput.value = '';
    chatMessageInput.focus();

    try {
      const enviado = await mensajeriaService.enviarMensaje(activeConversationId, text);
      if (!activeConversationMessages.some(m => m.id === enviado.id)) {
        activeConversationMessages.push(enviado);
        appendMessageToDom(enviado);
        scrollToBottom();
      }
      const target = conversationsList.find(c => c.id === activeConversationId);
      if (target) {
        target.ultimoMensaje = enviado.contenido;
        target.ultimoMensajeEn = enviado.enviadoEn;
        target.totalMensajes = (Number(target.totalMensajes) || 0) + 1;
        renderConversationsList();
      }
    } catch (err: any) {
      showAdminNotice('Error al enviar mensaje: ' + (err?.data?.message || err?.message), true);
    }
  }

  formChatSend?.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage();
  });

  chatSearchInput?.addEventListener('input', () => {
    renderConversationsList();
  });

  filterThreadsAll?.addEventListener('click', () => {
    threadsFilterMode = 'ALL';
    filterThreadsAll.classList.add('active');
    filterThreadsActive?.classList.remove('active');
    renderConversationsList();
  });

  filterThreadsActive?.addEventListener('click', () => {
    threadsFilterMode = 'ACTIVE';
    filterThreadsActive.classList.add('active');
    filterThreadsAll?.classList.remove('active');
    renderConversationsList();
  });

  btnRefreshMessages?.addEventListener('click', async () => {
    showAdminNotice('Sincronizando mensajería y salas en tiempo real...');
    try {
      conversationsList = await mensajeriaService.listarTodasAdmin();
      renderConversationsList();
      if (activeConversationId) {
        await openConversation(activeConversationId);
      }
    } catch (err: any) {
      showAdminNotice('Error al actualizar mensajería: ' + (err?.message || ''), true);
    }
  });

  // Modal "+ Abrir Sala por Viaje"
  function openTicketModal() {
    if (!modalNewTicket || !selectTicketViaje) return;
    selectTicketViaje.innerHTML = '<option value="">Selecciona un viaje publicado...</option>' + 
      ridesList.map(v => `
        <option value="${v.id}">${v.origenNombre} ➔ ${v.destinoNombre} (${v.fechaSalida} ${v.horaSalida}) - $${Number(v.tarifaAproximada).toFixed(2)}</option>
      `).join('');
    modalNewTicket.style.display = 'flex';
  }

  function closeTicketModal() {
    if (modalNewTicket) modalNewTicket.style.display = 'none';
    if (formOpenTicket) (formOpenTicket as HTMLFormElement).reset();
  }

  btnOpenNewTicket?.addEventListener('click', openTicketModal);
  btnEmptyOpenChat?.addEventListener('click', openTicketModal);
  btnCloseTicketModal?.addEventListener('click', closeTicketModal);
  btnCancelTicket?.addEventListener('click', closeTicketModal);

  formOpenTicket?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectTicketViaje) return;
    const viajeId = selectTicketViaje.value;
    if (!viajeId) {
      alert('Por favor selecciona un viaje para abrir la conversación.');
      return;
    }

    try {
      showAdminNotice('Abriendo sala de chat para el viaje...');
      const conv = await mensajeriaService.obtenerOCrearPorViaje(viajeId);
      
      const initialText = ticketInitialMsg?.value.trim();
      if (initialText) {
        await mensajeriaService.enviarMensaje(conv.id, initialText);
      }

      closeTicketModal();
      showAdminNotice('Sala de chat abierta exitosamente.');
      
      // Recargar lista y abrir conversación
      conversationsList = await mensajeriaService.listarTodasAdmin();
      renderConversationsList();
      await openConversation(conv.id);
    } catch (err: any) {
      showAdminNotice('Error al crear sala de chat: ' + (err?.data?.message || err?.message), true);
    }
  });

  // Quick responses
  document.querySelectorAll('.reply-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const reply = chip.getAttribute('data-reply');
      if (reply && chatMessageInput) {
        chatMessageInput.value = reply;
        sendMessage();
      }
    });
  });

  // 10. Cambio de Pestañas
  document.querySelectorAll('.admin-tab-btn').forEach(tab => {
    tab.addEventListener('click', (e) => {
      document.querySelectorAll('.admin-tab-btn').forEach(t => t.classList.remove('active'));
      (e.currentTarget as HTMLElement).classList.add('active');

      const targetPaneId = (e.currentTarget as HTMLElement).getAttribute('data-tab');
      document.querySelectorAll('.admin-tab-pane').forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });

      if (targetPaneId) {
        const targetPane = document.getElementById(targetPaneId);
        if (targetPane) {
          targetPane.style.display = 'block';
          targetPane.classList.add('active');
        }
      }
    });
  });

  // Inicializar al cargar
  checkAdminAuth();
</script>
