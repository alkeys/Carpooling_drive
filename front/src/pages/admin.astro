---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AuthModal from '../components/AuthModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Panel de Administración | Rutea El Salvador"
  description="Panel de control administrativo de Rutea. Gestión de usuarios, asignación de roles, catálogo de rutas, supervisión de viajes y configuración del sistema."
>
  <Navbar />

  <main class="admin-page-main">
    <div class="container">
      
      <!-- Admin Top Banner -->
      <div class="admin-top-header">
        <div class="admin-title-col">
          <div class="admin-badge-row">
            <span class="badge badge-sand">⚡ Módulo Administrativo</span>
            <span class="admin-role-pill" id="admin-user-pill">Verificando credenciales...</span>
          </div>
          <h1 class="admin-page-title">Centro de Control y Administración</h1>
          <p class="admin-page-subtitle">
            Supervisa usuarios, modera viajes, gestiona el catálogo oficial de rutas y audita la seguridad en tiempo real.
          </p>
        </div>

        <div class="admin-quick-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-refresh-admin-data">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
            <span>Sincronizar Datos</span>
          </button>
          <a href="/publicar" class="btn btn-primary btn-sm">
            <span>+ Publicar como Conductor</span>
          </a>
          <button type="button" class="btn btn-sm btn-admin-logout" id="btn-admin-logout" title="Cerrar sesión de administrador y borrar cookies">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>

      <!-- Auth Required Gate Banner (Shown if not ADMIN) -->
      <div class="admin-auth-gate" id="admin-auth-gate" style="display: none;">
        <div class="gate-card glass-card">
          <div class="gate-icon">🔒</div>
          <div class="gate-body">
            <h3>Acceso Restringido a Administradores</h3>
            <p>
              Esta sección requiere permisos de rol <code>ADMIN</code>. Inicia sesión con tus credenciales administrativas para desbloquear las operaciones de gestión.
            </p>
            <div class="gate-actions">
              <button type="button" class="btn btn-primary" id="btn-admin-gate-login">
                Iniciar Sesión con Cuenta Admin
              </button>
              <div class="demo-admin-hint">
                <span>💡 Cuenta Administradora: <code>admin@admin.com</code> / <code>admin</code></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Dashboard Container (Visible when authenticated) -->
      <div class="admin-dashboard-content" id="admin-dashboard-content">

        <!-- 1. Stats KPI Cards Grid -->
        <section class="admin-kpi-grid">
          <!-- Total Usuarios -->
          <div class="kpi-card glass-card">
            <div class="kpi-icon-wrap icon-users">👥</div>
            <div class="kpi-meta">
              <span class="kpi-label">Usuarios Registrados</span>
              <strong class="kpi-value" id="kpi-total-users">--</strong>
              <span class="kpi-sub" id="kpi-drivers-ratio">Cargando conductores...</span>
            </div>
          </div>

          <!-- Total Viajes -->
          <div class="kpi-card glass-card">
            <div class="kpi-icon-wrap icon-rides">🚗</div>
            <div class="kpi-meta">
              <span class="kpi-label">Viajes en el Sistema</span>
              <strong class="kpi-value" id="kpi-total-rides">--</strong>
              <span class="kpi-sub" id="kpi-active-rides">Disponibles en vivo</span>
            </div>
          </div>

          <!-- Total Rutas -->
          <div class="kpi-card glass-card">
            <div class="kpi-icon-wrap icon-routes">🛣️</div>
            <div class="kpi-meta">
              <span class="kpi-label">Rutas de Catálogo</span>
              <strong class="kpi-value" id="kpi-total-routes">--</strong>
              <span class="kpi-sub" id="kpi-active-routes">Rutas oficiales activas</span>
            </div>
          </div>

          <!-- System Status -->
          <div class="kpi-card glass-card">
            <div class="kpi-icon-wrap icon-system">🛡️</div>
            <div class="kpi-meta">
              <span class="kpi-label">Infraestructura API</span>
              <strong class="kpi-value status-online">PostGIS 16 OK</strong>
              <span class="kpi-sub">Spring Boot 3.4.3 & JWT</span>
            </div>
          </div>
        </section>

        <!-- 2. Admin Navigation Tabs -->
        <div class="admin-tabs-nav">
          <button type="button" class="admin-tab-btn active" data-tab="tab-users">
            <span>👥 Usuarios & Roles</span>
            <span class="tab-badge-count" id="badge-users-count">0</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-routes">
            <span>🛣️ Catálogo de Rutas</span>
            <span class="tab-badge-count" id="badge-routes-count">0</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-rides">
            <span>🚗 Moderación de Viajes</span>
            <span class="tab-badge-count" id="badge-rides-count">0</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-messages">
            <span>💬 Mensajería & Soporte</span>
            <span class="tab-badge-count" id="badge-messages-count">0</span>
          </button>
        </div>

        <!-- Notification / Toast for Admin -->
        <div class="admin-alert-banner" id="admin-alert-banner" style="display: none;" role="alert">
          <span class="alert-icon">ℹ️</span>
          <span id="admin-alert-text">Mensaje</span>
          <button type="button" class="alert-close-btn" id="btn-close-admin-alert">&times;</button>
        </div>

        <!-- ======================================================== -->
        <!-- TAB 1: GESTIÓN DE USUARIOS -->
        <!-- ======================================================== -->
        <section class="admin-tab-pane active" id="tab-users">
          <div class="pane-header-box">
            <div class="pane-title-wrap">
              <h2>Directorio de Usuarios de Rutea</h2>
              <p>Asigna o revoca roles administrativos (ADMIN), de conductor (CONDUCTOR) y gestiona accesos.</p>
            </div>

            <!-- Search and Filter Bar -->
            <div class="pane-filters-row">
              <div class="search-input-wrap">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input 
                  type="text" 
                  id="user-search-input" 
                  class="admin-search-field" 
                  placeholder="Buscar por nombre, correo o teléfono..." 
                />
              </div>

              <select id="user-role-filter" class="admin-filter-select">
                <option value="ALL">Todos los roles</option>
                <option value="ADMIN">Solo Administradores</option>
                <option value="CONDUCTOR">Solo Conductores</option>
                <option value="CLIENTE">Solo Pasajeros</option>
              </select>
            </div>
          </div>

          <!-- Users Table Container -->
          <div class="admin-table-container glass-card">
            <table class="admin-data-table" id="users-table">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Correo Electrónico</th>
                  <th>Teléfono</th>
                  <th>Roles Asignados</th>
                  <th>Estado</th>
                  <th>Registro</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody id="users-table-body">
                <tr>
                  <td colspan="7" class="table-loading-row">Cargando directorio de usuarios...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ======================================================== -->
        <!-- TAB 2: CATÁLOGO OFICIAL DE RUTAS -->
        <!-- ======================================================== -->
        <section class="admin-tab-pane" id="tab-routes" style="display: none;">
          <div class="pane-header-box">
            <div class="pane-title-wrap">
              <h2>Catálogo Oficial de Rutas</h2>
              <p>Rutas maestras predefinidas que los conductores pueden asociar a sus publicaciones.</p>
            </div>

            <div class="pane-actions-wrap">
              <button type="button" class="btn btn-primary" id="btn-open-create-route">
                <span>+ Nueva Ruta Oficial</span>
              </button>
            </div>
          </div>

          <!-- Routes Table Container -->
          <div class="admin-table-container glass-card">
            <table class="admin-data-table" id="routes-table">
              <thead>
                <tr>
                  <th>Nombre de la Ruta</th>
                  <th>Descripción / Trayecto</th>
                  <th>Estado</th>
                  <th>Fecha de Creación</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody id="routes-table-body">
                <tr>
                  <td colspan="5" class="table-loading-row">Cargando catálogo de rutas...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ======================================================== -->
        <!-- TAB 3: SUPERVISIÓN Y MODERACIÓN DE VIAJES -->
        <!-- ======================================================== -->
        <section class="admin-tab-pane" id="tab-rides" style="display: none;">
          <div class="pane-header-box">
            <div class="pane-title-wrap">
              <h2>Monitoreo y Moderación de Viajes</h2>
              <p>Revisa viajes publicados, cancela viajes sospechosos o modifica estados operativos en tiempo real.</p>
            </div>

            <div class="pane-filters-row">
              <div class="search-input-wrap">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input 
                  type="text" 
                  id="ride-search-input" 
                  class="admin-search-field" 
                  placeholder="Filtrar por origen o destino..." 
                />
              </div>

              <select id="ride-status-filter" class="admin-filter-select">
                <option value="ALL">Todos los estados</option>
                <option value="PUBLICADO">PUBLICADO</option>
                <option value="EN_CURSO">EN_CURSO</option>
                <option value="FINALIZADO">FINALIZADO</option>
                <option value="CANCELADO">CANCELADO</option>
              </select>
            </div>
          </div>

          <!-- Rides Table Container -->
          <div class="admin-table-container glass-card">
            <table class="admin-data-table" id="rides-table">
              <thead>
                <tr>
                  <th>Trayecto (Origen ➔ Destino)</th>
                  <th>Salida Programada</th>
                  <th>Cupos</th>
                  <th>Tarifa Sugerida</th>
                  <th>Estado</th>
                  <th>ID Viaje</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody id="rides-table-body">
                <tr>
                  <td colspan="7" class="table-loading-row">Cargando viajes activos...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ======================================================== -->
        <!-- TAB 4: MENSAJERÍA & SOPORTE EN TIEMPO REAL -->
        <!-- ======================================================== -->
        <section class="admin-tab-pane" id="tab-messages" style="display: none;">
          <div class="pane-header-box">
            <div class="pane-title-wrap">
              <h2>Mesa de Soporte y Chat en Tiempo Real</h2>
              <p>Supervisa conversaciones entre conductores y pasajeros, modera tickets de viaje y responde en directo mediante WebSocket STOMP.</p>
            </div>

            <div class="pane-filters-row">
              <div class="ws-connection-indicator" id="ws-status-badge">
                <span class="status-pulse-dot" id="ws-pulse-dot"></span>
                <span id="ws-status-label">Conectando WebSocket...</span>
              </div>

              <button type="button" class="btn btn-outline btn-sm" id="btn-open-new-ticket">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="16"></line>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
                <span>+ Abrir Sala por Viaje</span>
              </button>

              <button type="button" class="btn btn-outline btn-sm" id="btn-refresh-messages">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>Sincronizar</span>
              </button>
            </div>
          </div>

          <!-- Messages 2-Column Layout -->
          <div class="admin-chat-grid glass-card">
            <!-- Left: Sidebar Conversation List -->
            <div class="chat-threads-sidebar">
              <div class="threads-search-bar">
                <div class="search-input-wrap">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <input 
                    type="text" 
                    id="chat-search-input" 
                    class="admin-search-field" 
                    placeholder="Buscar ruta o usuario..." 
                  />
                </div>
                <div class="threads-filter-pills">
                  <button type="button" class="filter-pill active" id="filter-threads-all">Todas (<span id="threads-total-count">0</span>)</button>
                  <button type="button" class="filter-pill" id="filter-threads-active">Con Mensajes</button>
                </div>
              </div>

              <div class="threads-list" id="chat-threads-list">
                <div class="chat-thread-loading">Cargando salas de conversación...</div>
              </div>
            </div>

            <!-- Right: Live Chat Window -->
            <div class="chat-main-window" id="chat-main-window">
              <!-- Empty state -->
              <div class="chat-empty-state" id="chat-empty-state">
                <div class="empty-chat-icon">💬</div>
                <h3>Selecciona una conversación</h3>
                <p>Elige un hilo del panel lateral para inspeccionar el chat en vivo, responder como Soporte o verificar las condiciones del viaje.</p>
                <button type="button" class="btn btn-outline btn-sm" id="btn-empty-open-chat">
                  <span>+ Iniciar Chat de Viaje</span>
                </button>
              </div>

              <!-- Active Chat View -->
              <div class="chat-active-container" id="chat-active-container" style="display: none;">
                <!-- Header -->
                <div class="active-chat-header">
                  <div class="active-chat-info">
                    <div class="route-badge-row">
                      <span class="badge badge-fresh" id="chat-header-route">San Salvador ➔ La Libertad</span>
                      <span class="chat-trip-id" id="chat-header-trip-id">Viaje: #...</span>
                    </div>
                    <div class="chat-driver-meta">
                      <span class="chat-driver-name" id="chat-header-driver">Conductor: --</span>
                      <span class="dot-sep">·</span>
                      <span class="chat-participants-count" id="chat-header-participants">1 participante</span>
                    </div>
                  </div>
                  <div class="active-chat-status">
                    <span class="badge badge-sand" id="chat-live-badge">🟢 Conexión Activa</span>
                  </div>
                </div>

                <!-- Messages Stream -->
                <div class="active-chat-messages" id="chat-messages-container">
                  <!-- Rendered messages -->
                </div>

                <!-- Quick Response Chips -->
                <div class="chat-quick-replies">
                  <button type="button" class="reply-chip" data-reply="¡Hola! Soporte Rutea a su disposición. ¿Tienen alguna duda sobre la ruta o el vehículo?">
                    👋 Saludo Soporte
                  </button>
                  <button type="button" class="reply-chip" data-reply="Recordatorio de seguridad: favor confirmar punto de encuentro seguro y puntualidad.">
                    📍 Punto de Encuentro
                  </button>
                  <button type="button" class="reply-chip" data-reply="Este viaje cuenta con verificación de conductor y vehículo por Rutea.">
                    🛡️ Verificación Oficial
                  </button>
                </div>

                <!-- Composer -->
                <form class="active-chat-composer" id="form-chat-send" onsubmit="return false;">
                  <input 
                    type="text" 
                    id="chat-message-input" 
                    class="composer-input" 
                    placeholder="Escribe como Administrador / Soporte... (Presiona Enter)" 
                    autocomplete="off"
                    required
                  />
                  <button type="submit" class="btn btn-primary btn-sm composer-send-btn" id="btn-chat-send">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="22" y1="2" x2="11" y2="13"></line>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    <span>Enviar</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </section>

      </div>

    </div>
  </main>

  <!-- ======================================================== -->
  <!-- MODAL: GESTIÓN DE ROLES DE USUARIO -->
  <!-- ======================================================== -->
  <div class="admin-modal-backdrop" id="modal-roles" style="display: none;">
    <div class="admin-modal-box glass-card">
      <div class="modal-head">
        <h3>🛡️ Asignar Roles de Usuario</h3>
        <button type="button" class="modal-x-btn" id="btn-close-roles-modal">&times;</button>
      </div>

      <div class="modal-body">
        <p class="modal-sub">
          Modifica los privilegios del usuario: <strong id="modal-roles-username">Usuario</strong>
        </p>

        <form id="form-update-roles" onsubmit="return false;">
          <input type="hidden" id="modal-roles-user-id" />

          <div class="roles-checklist">
            <label class="role-check-item">
              <input type="checkbox" name="admin_role" value="ADMIN" />
              <div class="role-desc-wrap">
                <span class="role-tag-badge badge-admin">ADMIN</span>
                <span class="role-hint">Acceso completo al panel administrativo, catálogos y gestión de roles.</span>
              </div>
            </label>

            <label class="role-check-item">
              <input type="checkbox" name="admin_role" value="CONDUCTOR" />
              <div class="role-desc-wrap">
                <span class="role-tag-badge badge-conductor">CONDUCTOR</span>
                <span class="role-hint">Permite publicar viajes, registrar vehículos y responder solicitudes.</span>
              </div>
            </label>

            <label class="role-check-item">
              <input type="checkbox" name="admin_role" value="CLIENTE" />
              <div class="role-desc-wrap">
                <span class="role-tag-badge badge-cliente">CLIENTE / PASAJERO</span>
                <span class="role-hint">Permite buscar rutas, solicitar cupos y calificar viajes.</span>
              </div>
            </label>

            <label class="role-check-item">
              <input type="checkbox" name="admin_role" value="USUARIO" />
              <div class="role-desc-wrap">
                <span class="role-tag-badge badge-usuario">USUARIO BASE</span>
                <span class="role-hint">Rol fundamental de cuenta verificada en Rutea.</span>
              </div>
            </label>
          </div>

          <div class="modal-footer-actions">
            <button type="button" class="btn btn-ghost" id="btn-cancel-roles">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-save-roles">Guardar Cambios de Roles</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: EDITAR PERFIL DE USUARIO -->
  <!-- ======================================================== -->
  <div class="admin-modal-backdrop" id="modal-edit-user" style="display: none;">
    <div class="admin-modal-box glass-card">
      <div class="modal-head">
        <h3>✏️ Modificar Datos de Usuario</h3>
        <button type="button" class="modal-x-btn" id="btn-close-edit-user-modal">&times;</button>
      </div>

      <div class="modal-body">
        <form id="form-edit-user" onsubmit="return false;">
          <input type="hidden" id="modal-edit-user-id" />

          <div class="admin-form-row">
            <div class="form-group">
              <label for="edit-user-nombre">Nombre:</label>
              <input type="text" id="edit-user-nombre" class="admin-input" required />
            </div>
            <div class="form-group">
              <label for="edit-user-apellido">Apellido:</label>
              <input type="text" id="edit-user-apellido" class="admin-input" required />
            </div>
          </div>

          <div class="form-group">
            <label for="edit-user-telefono">Teléfono El Salvador (+503):</label>
            <input type="tel" id="edit-user-telefono" class="admin-input" required />
          </div>

          <div class="modal-footer-actions">
            <button type="button" class="btn btn-ghost" id="btn-cancel-edit-user">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-save-edit-user">Actualizar Perfil</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: CREAR / EDITAR RUTA DE CATÁLOGO -->
  <!-- ======================================================== -->
  <div class="admin-modal-backdrop" id="modal-route" style="display: none;">
    <div class="admin-modal-box glass-card">
      <div class="modal-head">
        <h3 id="modal-route-title">🛣️ Crear Nueva Ruta Oficial</h3>
        <button type="button" class="modal-x-btn" id="btn-close-route-modal">&times;</button>
      </div>

      <div class="modal-body">
        <form id="form-route" onsubmit="return false;">
          <input type="hidden" id="modal-route-id" />

          <div class="form-group">
            <label for="route-nombre">Nombre de la Ruta:</label>
            <input 
              type="text" 
              id="route-nombre" 
              class="admin-input" 
              placeholder="Ej. San Salvador ➔ Puerto de La Libertad (Surf City)" 
              required 
            />
          </div>

          <div class="form-group">
            <label for="route-descripcion">Descripción del Recorrido:</label>
            <textarea 
              id="route-descripcion" 
              class="admin-textarea" 
              rows="3" 
              placeholder="Ej. Recorrido por Carretera al Puerto CA-4, conectando Multiplaza con el malecón del puerto y playas aledañas." 
              required
            ></textarea>
          </div>

          <div class="modal-footer-actions">
            <button type="button" class="btn btn-ghost" id="btn-cancel-route">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-save-route">Guardar Ruta</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL: ABRIR SALA DE CHAT POR VIAJE -->
  <!-- ======================================================== -->
  <div class="admin-modal-backdrop" id="modal-new-ticket" style="display: none;">
    <div class="admin-modal-box glass-card">
      <div class="modal-head">
